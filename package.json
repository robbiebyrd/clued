{
  "name": "@robbiebyrd/clued",
  "version": "1.0.2",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "description": "Claude Code plugin — mirrors session data to MongoDB",
  "bin": {
    "clued": "./bin/clued.js"
  },
  "files": [
    "dist/mcp.mjs",
    "bin/clued.js"
  ],
  "scripts": {
    "build": "node --import tsx/esm src/build.ts",
    "lint": "oxlint src/ test/ enrichers/",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test 'test/*.test.ts'",
    "test:integration": "node --import tsx/esm --test 'test/integration/*.test.ts'"
  },
  "dependencies": {
    "mongodb": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "oxlint": "1.85.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
