# syntax=docker/dockerfile:1
#
# The clued server image: `mind-palace server run` serving sessions, plans
# and stories over HTTPS behind bearer tokens (see docs/server.md).
#
# The image is assembled from the binaries scripts/build-binaries.sh wrote
# (no compiler runs here): BINARIES names the directory holding
# mind-palace_linux_amd64 and mind-palace_linux_arm64, and the one matching
# the image's platform is copied in. The version /health reports is the one
# the build script stamped into them (VERSION, else the manifest's). The
# licences of the modules the binary links (`build-binaries.sh --licenses`,
# BINARIES/THIRD_PARTY_LICENSES) are copied to /usr/share/licenses/clued-server/
# next to clued's own LICENSE and NOTICE (Apache-2.0 section 4).
#
#   scripts/build-binaries.sh --target linux/amd64 --target linux/arm64 dist
#   scripts/build-binaries.sh --licenses dist
#   docker build -f Dockerfile.server -t ghcr.io/robbiebyrd/clued-server:dev .
#   docker buildx build -f Dockerfile.server --platform linux/amd64,linux/arm64 --build-arg BINARIES=release-assets .
#
# Mounts (all read-only; the server re-reads the token file when it changes):
#   /etc/clued/tokens.json               the token file (`mind-palace server token create`)
#   /etc/clued/mind-palace.config.yaml   the server's plan and story storage (database only)
#   /etc/clued/tls/                      cert.pem and key.pem when the server terminates TLS
#
# Environment (each is the fallback of the matching `server run` flag):
#   CLUED_SERVER_ADDR          listen address; the image sets 0.0.0.0:8443
#   CLUED_SERVER_TOKENS        token file; the image sets /etc/clued/tokens.json
#   CLUED_SERVER_TLS_CERT      PEM certificate, e.g. /etc/clued/tls/cert.pem
#   CLUED_SERVER_TLS_KEY       PEM private key, e.g. /etc/clued/tls/key.pem
#   CLUED_SERVER_BEHIND_PROXY  "true" to serve plain HTTP because a reverse proxy
#                              terminates TLS (one of TLS or this is required off loopback)
#   MIND_PALACE_CONFIG         the plan and story config, e.g. /etc/clued/mind-palace.config.yaml
#   CLUED_MONGO_URL            MongoDB for sessions, e.g. mongodb://mongo:27017
#   CLUED_DB_NAME              its database (default claude_sessions)
#
# The runtime image is distroless: no shell and no HTTP client, so there is
# no HEALTHCHECK here; probe GET /health from the host or the orchestrator.

ARG BINARIES=dist

FROM gcr.io/distroless/static-debian12:nonroot
ARG BINARIES
ARG VERSION=dev
LABEL org.opencontainers.image.title="clued-server" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/robbiebyrd/clued" \
      org.opencontainers.image.vendor="Space Hippo, LC" \
      org.opencontainers.image.version="${VERSION}"
# TARGETARCH is set by BuildKit for the platform being built (amd64, arm64).
ARG TARGETARCH
# Artifacts lose their mode on the way through CI, so the bit is set here.
COPY --chmod=755 ${BINARIES}/mind-palace_linux_${TARGETARCH} /usr/local/bin/mind-palace
COPY LICENSE NOTICE /usr/share/licenses/clued-server/
COPY ${BINARIES}/THIRD_PARTY_LICENSES/ /usr/share/licenses/clued-server/THIRD_PARTY_LICENSES/
ENV CLUED_SERVER_ADDR=0.0.0.0:8443 \
    CLUED_SERVER_TOKENS=/etc/clued/tokens.json
EXPOSE 8443
USER nonroot:nonroot
ENTRYPOINT ["mind-palace", "server", "run"]
