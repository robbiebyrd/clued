#!/usr/bin/env bash
# Launches the mind-palace binary with the given arguments.
# Resolution order:
#   1. When devRepoPath is set in the config, a build of $devRepoPath/mind-palace,
#      refreshed whenever a .go file there is newer than the binary.
#   2. The release the plugin pins: the `version` in .claude-plugin/plugin.json
#      names the GitHub release v<version>, whose mind-palace_<os>_<arch> asset
#      is downloaded once into $BIN_DIR/releases/v<version>/ and verified
#      against the release's SHA256SUMS.
#   3. `mind-palace` on PATH.
#   4. A manually installed binary at $BIN_DIR/mind-palace.
# `--build-only` performs the dev build step without running the binary.
# `--locate` prints the path of the binary that would run (or exits 1).
#
# CLUED_RELEASE_URL overrides where releases are fetched from (the directory
# that holds v<version>/SHA256SUMS and v<version>/mind-palace_<os>_<arch>);
# `off` disables the download. Both are for tests and mirrors.

DATA_DIR="${HOME}/.claude/plugins/data/clued"
CONFIG_FILE="${DATA_DIR}/config.json"
BIN_DIR="${DATA_DIR}/bin"
BIN="${BIN_DIR}/mind-palace"
REBUILT_MARKER="${BIN_DIR}/.rebuilt"
PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="${PLUGIN_ROOT}/.claude-plugin/plugin.json"
RELEASE_URL="${CLUED_RELEASE_URL:-https://github.com/robbiebyrd/clued/releases/download}"
# A failed download is not retried for this many minutes, so an offline
# machine does not pay for a download attempt on every hook.
RETRY_AFTER_MINUTES=10

MODE=run
case "${1:-}" in
  --build-only) MODE=build-only; shift ;;
  --locate) MODE=locate; shift ;;
esac

json_string() {
  # json_string FILE KEY prints the string value of the top-level KEY, or nothing.
  [[ -f "$1" ]] || return 0
  if command -v jq &>/dev/null; then
    jq -r --arg k "$2" '.[$k] // empty' "$1" 2>/dev/null
  else
    sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$1" | head -1
  fi
}

dev_repo_path() { json_string "$CONFIG_FILE" devRepoPath; }

plugin_version() { json_string "$MANIFEST" version; }

# Builds the dev checkout into $BIN when it is missing or any .go file is newer.
build_from_dev_repo() {
  local module="$1/mind-palace"
  [[ -d "$module" ]] || return 1
  if [[ -x "$BIN" ]] && [[ -z "$(find "$module" -name '*.go' -newer "$BIN" -print -quit)" ]]; then
    return 0
  fi
  command -v go &>/dev/null || { echo "clued: devRepoPath is set but go is not installed" >&2; return 1; }
  mkdir -p "$BIN_DIR"
  (cd "$module" && go build -o "$BIN" ./cmd/mind-palace) >&2 || return 1
  touch "$REBUILT_MARKER"
}

# Prints the name of the release asset for this machine (mind-palace_<os>_<arch>[.exe]).
release_asset_name() {
  local os arch
  case "$(uname -s)" in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    MINGW*|MSYS*|CYGWIN*|Windows_NT) os=windows ;;
    *) return 1 ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64) arch=amd64 ;;
    aarch64|arm64) arch=arm64 ;;
    armv6l|armv7l|armv8l) arch=arm ;;
    *) return 1 ;;
  esac
  [[ "$os" == windows ]] && echo "mind-palace_${os}_${arch}.exe" || echo "mind-palace_${os}_${arch}"
}

sha256_of() {
  if command -v sha256sum &>/dev/null; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum &>/dev/null; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    return 1
  fi
}

# fetch URL DEST downloads one file with curl or wget.
fetch() {
  if command -v curl &>/dev/null; then
    curl -fsSL --retry 2 --max-time 300 -o "$2" "$1"
  elif command -v wget &>/dev/null; then
    wget -q -T 300 -O "$2" "$1"
  else
    echo "clued: curl or wget is needed to download the mind-palace binary" >&2
    return 1
  fi
}

# download_release DIR NAME EXE fetches the pinned release's SHA256SUMS and
# the asset NAME into DIR, verifies the asset and installs it as DIR/EXE.
download_release() {
  local dir="$1" name="$2" exe="$3" version="$4"
  local base="${RELEASE_URL}/v${version}" sums="${dir}/SHA256SUMS" tmp="${dir}/.${name}.$$" sum actual
  if ! fetch "${base}/SHA256SUMS" "$sums"; then
    echo "clued: could not download ${base}/SHA256SUMS (is release v${version} published?)" >&2
    return 1
  fi
  sum="$(awk -v n="$name" '$2 == n {print $1; exit}' "$sums")"
  if [[ -z "$sum" ]]; then
    echo "clued: release v${version} ships no ${name}" >&2
    return 1
  fi
  echo "clued: downloading mind-palace v${version} (${name})" >&2
  if ! fetch "${base}/${name}" "$tmp"; then
    rm -f "$tmp"
    echo "clued: could not download ${base}/${name}" >&2
    return 1
  fi
  actual="$(sha256_of "$tmp")" || { rm -f "$tmp"; echo "clued: sha256sum or shasum is needed to verify the downloaded binary" >&2; return 1; }
  if [[ "$actual" != "$sum" ]]; then
    rm -f "$tmp"
    echo "clued: downloaded ${name} does not match the release's SHA256SUMS (got ${actual}); not using it" >&2
    return 1
  fi
  chmod +x "$tmp" && mv -f "$tmp" "$exe" || { rm -f "$tmp"; return 1; }
}

# Prints the path of the binary of the release the plugin pins, downloading
# it on first use. Copies of other releases are removed once the new one is
# in place (a running daemon keeps its own copy open; on Windows the removal
# of an in-use file fails harmlessly).
release_binary() {
  local version name exename dir exe failed old i
  [[ "$RELEASE_URL" != off ]] || return 1
  version="$(plugin_version)"
  [[ -n "$version" ]] || return 1
  name="$(release_asset_name)" || return 1
  exename=mind-palace
  [[ "$name" == *.exe ]] && exename=mind-palace.exe
  dir="${BIN_DIR}/releases/v${version}"
  exe="${dir}/${exename}"
  if [[ -x "$exe" ]]; then
    echo "$exe"
    return 0
  fi
  failed="${dir}/.download-failed"
  if [[ -f "$failed" ]] && [[ -n "$(find "$failed" -mmin "-${RETRY_AFTER_MINUTES}" 2>/dev/null)" ]]; then
    return 1
  fi
  mkdir -p "$dir" || return 1
  # Hooks fire concurrently at session start: one of them downloads, the
  # others wait for its result.
  if ! mkdir "${dir}/.lock" 2>/dev/null; then
    for i in $(seq 1 120); do
      sleep 0.5
      if [[ -x "$exe" ]]; then
        echo "$exe"
        return 0
      fi
      [[ -d "${dir}/.lock" ]] || break
    done
    [[ -x "$exe" ]] && { echo "$exe"; return 0; }
    rmdir "${dir}/.lock" 2>/dev/null
    return 1
  fi
  if ! download_release "$dir" "$name" "$exe" "$version"; then
    touch "$failed"
    rmdir "${dir}/.lock" 2>/dev/null
    return 1
  fi
  rm -f "$failed"
  rmdir "${dir}/.lock" 2>/dev/null
  for old in "${BIN_DIR}"/releases/*/; do
    [[ "${old%/}" == "$dir" ]] || rm -rf "$old" 2>/dev/null
  done
  echo "$exe"
}

DEV_REPO="$(dev_repo_path)"
if [[ -n "$DEV_REPO" ]]; then
  build_from_dev_repo "$DEV_REPO" || echo "clued: building mind-palace from ${DEV_REPO}/mind-palace failed" >&2
fi

if [[ "$MODE" == build-only ]]; then
  exit 0
fi

resolve() {
  # A developer who set devRepoPath wants their own build, not a release.
  if [[ -n "$DEV_REPO" ]] && [[ -x "$BIN" ]]; then
    echo "$BIN"
    return 0
  fi
  local release
  if release="$(release_binary)"; then
    echo "$release"
    return 0
  fi
  if command -v mind-palace &>/dev/null; then
    command -v mind-palace
    return 0
  fi
  if [[ -x "$BIN" ]]; then
    echo "$BIN"
    return 0
  fi
  return 1
}

if TARGET="$(resolve)"; then
  if [[ "$MODE" == locate ]]; then
    echo "$TARGET"
    exit 0
  fi
  exec "$TARGET" "$@"
fi

VERSION="$(plugin_version)"
cat >&2 <<MSG
clued: mind-palace binary not found for $(uname -s)/$(uname -m): release v${VERSION:-?} of robbiebyrd/clued could not be downloaded and none is on PATH.
Run /clued-setup, or install it with:
  go install github.com/robbiebyrd/clued/mind-palace/cmd/mind-palace@latest
or download mind-palace_<os>_<arch> from https://github.com/robbiebyrd/clued/releases/tag/v${VERSION:-<version>} to ${BIN}
MSG
exit 1
