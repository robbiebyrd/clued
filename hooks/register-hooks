#!/usr/bin/env bash
# Writes clued hook entries into ~/.claude/settings.json (or $CLAUDE_CONFIG_DIR/settings.json).
# Safe to run multiple times: replaces stale clued entries (including ones from
# plugin versions that kept the shim at bin/clued), preserves all others.

HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RELAY="${HOOKS_DIR}/event-relay"
CHECK_SETUP="${HOOKS_DIR}/check-setup"
SESSION_START="${HOOKS_DIR}/session-start"
CLUED="$(cd "${HOOKS_DIR}/.." && pwd)/scripts/clued"
SETTINGS="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}/settings.json"

if ! command -v jq &>/dev/null; then
  echo "clued register-hooks: jq not found, skipping hook registration" >&2
  exit 0
fi

if [[ ! -f "$SETTINGS" ]]; then
  mkdir -p "$(dirname "$SETTINGS")"
  echo '{}' > "$SETTINGS"
fi

TMP="${SETTINGS}.tmp.$$"
jq \
  --arg relay         "$RELAY" \
  --arg check_setup   "$CHECK_SETUP" \
  --arg session_start "$SESSION_START" \
  --arg clued         "$CLUED" \
  '
  def is_clued:
    [.hooks[].command] | any(test("/hooks/(event-relay|session-start|check-setup|guard-superpowers-plans)$|/(bin|scripts)/clued (hook |session memory-ingest)"));

  def binary_hook(args):
    {"hooks": [{"type": "command", "command": ($clued + " " + args)}]};

  def matched_binary_hook(matcher; args):
    binary_hook(args) + {"matcher": matcher};

  def relay_hook(cmd):
    {"hooks": [{"type": "command", "command": cmd, "async": true}]};

  def replace(ev; entries):
    .hooks[ev] = ((.hooks[ev] // []) | map(select(is_clued | not))) + entries;

  . |
  replace("SessionStart"; [
    {"hooks": [
      {"type": "command", "command": $check_setup},
      {"type": "command", "command": $session_start, "async": true},
      {"type": "command", "command": ($clued + " hook status-review")},
      {"type": "command", "command": ($clued + " hook prime")}
    ]}]) |
  replace("PreToolUse"; [
    relay_hook($relay),
    matched_binary_hook("Write|Edit|MultiEdit|NotebookEdit|Bash|EnterPlanMode|ExitPlanMode"; "hook write-guard")
  ]) |
  replace("PostToolUse";      [relay_hook($relay)]) |
  replace("UserPromptSubmit"; [relay_hook($relay), binary_hook("hook status-review --every 30m")]) |
  replace("Stop";             [relay_hook($relay), binary_hook("hook stop-guard")]) |
  replace("SessionEnd";       [relay_hook($relay), {"hooks": [{"type": "command", "command": ($clued + " session memory-ingest --quiet"), "async": true}]}]) |
  replace("Notification";     [relay_hook($relay)]) |
  replace("SubagentStop";     [relay_hook($relay)])
  ' "$SETTINGS" > "$TMP" && mv "$TMP" "$SETTINGS"

# The status line. When config.json sets statusLine (or CLUED_STATUS_LINE is
# 1/true/yes/on), `clued hook status` becomes Claude Code's status line
# command, sampling the context window and the usage limits; the command
# configured before it is kept in statusline.json next to config.json and run
# after the sample, so the line itself does not change. Otherwise a clued
# status line is taken out again and that command put back.
CONFIG_FILE="${HOME}/.claude/plugins/data/clued/config.json"
STATUS_THEN="$(dirname "$CONFIG_FILE")/statusline.json"
STATUS_CMD="$CLUED hook status"
want=$(jq -r 'if .statusLine == true then "true" else "false" end' "$CONFIG_FILE" 2>/dev/null || echo false)
case "${CLUED_STATUS_LINE:-}" in
  1|true|yes|on) want=true ;;
  0|false|no|off) want=false ;;
esac
current=$(jq -r '.statusLine.command // empty' "$SETTINGS")
is_clued_status() { [[ "$1" == *"/scripts/clued hook status"* ]]; }
if [[ "$want" == true ]]; then
  if [[ -n "$current" ]] && ! is_clued_status "$current"; then
    mkdir -p "$(dirname "$STATUS_THEN")"
    jq -n --arg then "$current" '{then: $then}' > "$STATUS_THEN"
  fi
  if [[ "$current" != "$STATUS_CMD" ]]; then
    jq --arg cmd "$STATUS_CMD" '.statusLine = ((.statusLine // {}) + {"type": "command", "command": $cmd})' "$SETTINGS" > "$TMP" && mv "$TMP" "$SETTINGS"
    echo "clued: status line set to $STATUS_CMD"
  fi
elif [[ -n "$current" ]] && is_clued_status "$current"; then
  then=$(jq -r '.then // empty' "$STATUS_THEN" 2>/dev/null)
  if [[ -n "$then" ]]; then
    jq --arg cmd "$then" '.statusLine.command = $cmd' "$SETTINGS" > "$TMP" && mv "$TMP" "$SETTINGS"
  else
    jq 'del(.statusLine)' "$SETTINGS" > "$TMP" && mv "$TMP" "$SETTINGS"
  fi
  rm -f "$STATUS_THEN"
  echo "clued: status line restored"
fi

echo "clued: registered hooks in $SETTINGS"
