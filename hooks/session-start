#!/usr/bin/env bash
PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLUED="${PLUGIN_ROOT}/bin/clued"

# Keep hooks registered in settings.json pointing to this plugin installation.
"${PLUGIN_ROOT}/hooks/register-hooks" &>/dev/null &
CONFIG_FILE="${HOME}/.claude/plugins/data/clued/config.json"
DATA_DIR="${HOME}/.claude/plugins/data/clued"
BIN_DIR="${DATA_DIR}/bin"
DAEMON_LOG="${DATA_DIR}/daemon.log"
DEFAULT_PORT=8085

if command -v jq &>/dev/null && [[ -f "$CONFIG_FILE" ]]; then
  PORT=$(jq -r ".port // ${DEFAULT_PORT}" "$CONFIG_FILE" 2>/dev/null || echo "$DEFAULT_PORT")
  DEV_REPO=$(jq -r '.devRepoPath // empty' "$CONFIG_FILE" 2>/dev/null)
else
  PORT=$DEFAULT_PORT
fi

PORT="${CLUED_PORT:-$PORT}"

daemon_ok() {
  curl -sf --max-time 1 "http://127.0.0.1:${PORT}/health" &>/dev/null
}

# When devRepoPath is set, bin/clued rebuilds the binary if the sources changed.
# A running daemon keeps the old build, so restart it when a rebuild happened.
if [[ -n "$DEV_REPO" ]]; then
  rm -f "${BIN_DIR}/.rebuilt"
  "$CLUED" --build-only &>/dev/null
  if [[ -f "${BIN_DIR}/.rebuilt" ]]; then
    pkill -f 'mind-palace session daemon$' 2>/dev/null || true
    sleep 0.5
    echo "clued: binary rebuilt — daemon restarted. Relaunch Claude Code to reconnect MCP." >&2
  fi
fi

# The daemon is detached and outlives plugin updates. The path bin/clued
# resolves changes when a new bundled binary is unpacked (it is keyed by the
# binary's hash), so compare it with the path recorded at the last daemon
# start and restart a daemon that is running an older build.
BINARY_MARKER="${DATA_DIR}/daemon.binary"
RESOLVED="$("$CLUED" --locate 2>/dev/null)"
if [[ -n "$RESOLVED" ]] && daemon_ok && [[ "$(cat "$BINARY_MARKER" 2>/dev/null)" != "$RESOLVED" ]]; then
  pkill -f 'mind-palace session daemon$' 2>/dev/null || true
  sleep 0.5
  echo "clued: mind-palace binary changed — daemon restarted. Relaunch Claude Code to reconnect MCP." >&2
fi

if ! daemon_ok; then
  mkdir -p "$DATA_DIR"
  printf '%s\n' "$RESOLVED" > "$BINARY_MARKER"
  "$CLUED" session daemon >"$DAEMON_LOG" 2>&1 &
  DAEMON_PID=$!
  disown
  for _ in $(seq 1 15); do
    sleep 0.2
    if ! kill -0 "$DAEMON_PID" 2>/dev/null; then
      echo "clued: daemon exited on startup: $(tail -n 1 "$DAEMON_LOG" 2>/dev/null)" >&2
      break
    fi
    if daemon_ok; then break; fi
  done
fi

"$CLUED" session backfill &>/dev/null &
disown
exit 0
