#!/usr/bin/env bash
PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLUED="${PLUGIN_ROOT}/scripts/clued"

# A memory engine's own `claude -p` runs with CLUED_NO_CAPTURE=1: it is
# never captured, relayed or primed.
if [[ "${CLUED_NO_CAPTURE:-}" == "1" ]]; then
  cat >/dev/null 2>&1
  exit 0
fi

# Point the hook launcher (bin/clued-hook, plugin-root) at this plugin
# installation, refresh an opt-in settings mirror and remove the mirror an
# older clued wrote (hooks/hooks.json registers every hook; one in both
# places runs twice).
"${PLUGIN_ROOT}/hooks/register-hooks" --quiet &>/dev/null &
CONFIG_FILE="${HOME}/.claude/plugins/data/clued/config.json"
DATA_DIR="${HOME}/.claude/plugins/data/clued"
# clued has its own memory now: remove, once, the listener older versions
# installed into claude-remember (uninstall runs the removal again).
REMOVED_STAMP="${DATA_DIR}/remember-listener-removed"
if [[ ! -f "$REMOVED_STAMP" ]]; then
  "${PLUGIN_ROOT}/hooks/remove-remember-listener" &>/dev/null
  mkdir -p "$DATA_DIR" && date -u +%Y-%m-%dT%H:%M:%SZ > "$REMOVED_STAMP"
fi
BIN_DIR="${DATA_DIR}/bin"
DAEMON_LOG="${DATA_DIR}/daemon.log"
DEFAULT_PORT=8085

if command -v jq &>/dev/null && [[ -f "$CONFIG_FILE" ]]; then
  PORT=$(jq -r ".port // ${DEFAULT_PORT}" "$CONFIG_FILE" 2>/dev/null || echo "$DEFAULT_PORT")
  DEV_REPO=$(jq -r '.devRepoPath // empty' "$CONFIG_FILE" 2>/dev/null)
  SERVER_URL=$(jq -r '.serverUrl // empty' "$CONFIG_FILE" 2>/dev/null)
else
  PORT=$DEFAULT_PORT
fi

PORT="${CLUED_PORT:-$PORT}"
SERVER_URL="${CLUED_SERVER_URL:-$SERVER_URL}"

# Remote mode: the client runs no daemon. Each hook relays its own event to
# the server, so the SessionStart payload goes through the relay as well
# (detached, like the daemon launch): that tracks the starting session on
# the server and catches up its transcript. The backfill loads the older
# transcripts the same way it does in local mode.
if [[ -n "$SERVER_URL" ]]; then
  BODY=$(cat)
  printf '%s' "$BODY" | "$CLUED" hook relay &>/dev/null &
  disown
  "$CLUED" session backfill &>/dev/null &
  disown
  # A clued cloud manages client settings per account: apply them (a plain
  # clued server has no such route and the command is a no-op).
  "$CLUED" session config-pull --quiet &>/dev/null &
  disown
  exit 0
fi

# A Claude Code cloud container never runs local mode: it is reclaimed after
# the session, so no daemon or MongoDB is started here (check-setup tells the
# user to link it to clued cloud or a clued server).
if [[ "${CLAUDE_CODE_REMOTE:-}" == "true" ]]; then
  exit 0
fi

daemon_ok() {
  curl -sf --max-time 1 "http://127.0.0.1:${PORT}/health" &>/dev/null
}

# When devRepoPath is set, scripts/clued rebuilds the binary if the sources changed.
# A running daemon keeps the old build, so restart it when a rebuild happened.
if [[ -n "$DEV_REPO" ]]; then
  rm -f "${BIN_DIR}/.rebuilt"
  "$CLUED" --build-only &>/dev/null
  if [[ -f "${BIN_DIR}/.rebuilt" ]]; then
    pkill -f 'mind-palace session daemon$' 2>/dev/null || true
    sleep 0.5
    echo "clued: binary rebuilt — daemon restarted. Relaunch Claude Code to reconnect MCP." >&2
  fi
fi

# The daemon is detached and outlives plugin updates. The path scripts/clued
# resolves changes when a plugin update pins a new release (it is keyed by
# the release version), so compare it with the path recorded at the last
# daemon start and restart a daemon that is running an older build.
BINARY_MARKER="${DATA_DIR}/daemon.binary"
RESOLVED="$("$CLUED" --locate 2>/dev/null)"
if [[ -n "$RESOLVED" ]] && daemon_ok && [[ "$(cat "$BINARY_MARKER" 2>/dev/null)" != "$RESOLVED" ]]; then
  pkill -f 'mind-palace session daemon$' 2>/dev/null || true
  sleep 0.5
  echo "clued: mind-palace binary changed — daemon restarted. Relaunch Claude Code to reconnect MCP." >&2
fi

if ! daemon_ok; then
  mkdir -p "$DATA_DIR"
  printf '%s\n' "$RESOLVED" > "$BINARY_MARKER"
  "$CLUED" session daemon >"$DAEMON_LOG" 2>&1 &
  DAEMON_PID=$!
  disown
  for _ in $(seq 1 15); do
    sleep 0.2
    if ! kill -0 "$DAEMON_PID" 2>/dev/null; then
      echo "clued: daemon exited on startup: $(tail -n 1 "$DAEMON_LOG" 2>/dev/null)" >&2
      break
    fi
    if daemon_ok; then break; fi
  done
fi

"$CLUED" session backfill &>/dev/null &
disown
exit 0
