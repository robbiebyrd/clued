#!/usr/bin/env bash
# The WAL holds session content: keep it and its directory private.
umask 077

# A memory engine's own `claude -p` runs with CLUED_NO_CAPTURE=1: it is
# never captured, relayed or primed.
if [[ "${CLUED_NO_CAPTURE:-}" == "1" ]]; then
  cat >/dev/null 2>&1
  exit 0
fi
PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_FILE="${HOME}/.claude/plugins/data/clued/config.json"
DEFAULT_PORT=8085

if command -v jq &>/dev/null && [[ -f "$CONFIG_FILE" ]]; then
  PORT=$(jq -r ".port // ${DEFAULT_PORT}" "$CONFIG_FILE" 2>/dev/null || echo "$DEFAULT_PORT")
  SERVER_URL=$(jq -r '.serverUrl // empty' "$CONFIG_FILE" 2>/dev/null)
  WAL_DIR=$(dirname "$CONFIG_FILE")
else
  PORT=$DEFAULT_PORT
  WAL_DIR="${HOME}/.claude/plugins/data/clued"
fi
PORT="${CLUED_PORT:-$PORT}"
SERVER_URL="${CLUED_SERVER_URL:-$SERVER_URL}"
WAL_FILE="${CLUED_WAL_PATH:-${WAL_DIR}/events.wal}"

BODY=$(cat)

# A session started with CLUED_MEMORY=off keeps out of memory: every event
# says so, and the capture records it on the session.
if [[ "${CLUED_MEMORY:-}" == "off" ]] && command -v jq &>/dev/null; then
  BODY=$(printf '%s' "$BODY" | jq -c '. + {clued_memory: "off"}' 2>/dev/null || printf '%s' "$BODY")
fi

# Native memory: at SessionEnd the session's note (and the roll-ups it
# completes), at PreCompact its checkpoint, run detached so the hook never
# waits on an engine. Nothing runs when memory.engine (CLUED_MEMORY_ENGINE)
# is off or the session was started with CLUED_MEMORY=off.
run_memory() {
  command -v jq &>/dev/null || return 0
  [[ "${CLUED_MEMORY:-}" == "off" ]] && return 0
  local event sid engine
  event=$(printf '%s' "$BODY" | jq -r '.hook_event_name // empty' 2>/dev/null)
  [[ "$event" == "SessionEnd" || "$event" == "PreCompact" ]] || return 0
  sid=$(printf '%s' "$BODY" | jq -r '.session_id // empty' 2>/dev/null)
  [[ -n "$sid" ]] || return 0
  engine=""
  [[ -f "$CONFIG_FILE" ]] && engine=$(jq -r '.memory.engine // empty' "$CONFIG_FILE" 2>/dev/null)
  engine="${CLUED_MEMORY_ENGINE:-$engine}"
  [[ "$engine" == "off" ]] && return 0
  if [[ "$event" == "SessionEnd" ]]; then
    nohup "${PLUGIN_ROOT}/scripts/clued" session memory run --session "$sid" --quiet --delay 10s </dev/null &>/dev/null &
  else
    nohup "${PLUGIN_ROOT}/scripts/clued" session memory run --session "$sid" --quiet --checkpoint </dev/null &>/dev/null &
  fi
  disown
}

# Remote mode: no daemon listens on loopback. The Go relay stores the event
# on the server, pushes the session's transcript delta and owns the WAL
# (it buffers a failed insert itself), so nothing is written from here. The
# hook is async and must never fail the session, whatever the relay did.
if [[ -n "$SERVER_URL" ]]; then
  printf '%s' "$BODY" | "${PLUGIN_ROOT}/scripts/clued" hook relay >/dev/null 2>&1
  run_memory
  exit 0
fi

# A Claude Code cloud container without a server runs no daemon (see
# session-start): a WAL there would only fill a disk that is thrown away.
if [[ "${CLAUDE_CODE_REMOTE:-}" == "true" ]]; then
  exit 0
fi

if ! printf '%s' "$BODY" | /usr/bin/curl -sf -X POST "http://127.0.0.1:${PORT}/event" \
  -H "Content-Type: application/json" \
  --data-binary @- 2>/dev/null; then
  mkdir -p "$(dirname "$WAL_FILE")"
  printf '%s\n' "$BODY" >> "$WAL_FILE"
fi
run_memory
exit 0
