#!/usr/bin/env bash
# Installs clued's listener into every claude-remember plugin on this machine,
# so each memory save and consolidation posts the new summaries to the clued
# daemon (`scripts/clued session memory-ingest`). claude-remember runs the
# executables under <plugin>/hooks.d/<event>/ with REMEMBER_DIR and
# PROJECT_DIR exported, refuses listeners that are group- or world-writable,
# and a plugin update replaces that directory, so session-start re-runs this
# on every start. Nothing is printed on success; a missing claude-remember is
# not an error.
#
# CLUED_REMEMBER_ROOTS (colon-separated plugin roots) overrides the search.

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLUED="${PLUGIN_ROOT}/scripts/clued"
LISTENER_NAME="70-clued-ingest.sh"
PLUGINS_DIR="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}/plugins"

# remember_roots prints the candidate claude-remember plugin roots, one per line.
remember_roots() {
  if [[ -n "${CLUED_REMEMBER_ROOTS:-}" ]]; then
    tr ':' '\n' <<< "$CLUED_REMEMBER_ROOTS"
    return
  fi
  if command -v jq &>/dev/null && [[ -f "${PLUGINS_DIR}/installed_plugins.json" ]]; then
    jq -r '(.plugins // {}) | to_entries[] | select(.key | startswith("remember@")) | .value | if type == "array" then .[] else . end | .installPath // empty' \
      "${PLUGINS_DIR}/installed_plugins.json" 2>/dev/null
  fi
  for d in "${PLUGINS_DIR}"/cache/*/remember/* "${PLUGINS_DIR}"/synced/*/remember "${PLUGINS_DIR}"/marketplaces/*/plugins/remember; do
    [[ -d "$d" ]] && echo "$d"
  done
}

listener_body() {
  cat <<SCRIPT
#!/bin/bash
# Installed by the clued plugin (hooks/install-remember-listener) and rewritten
# on every clued session start. Posts the new records of this memory store to
# the clued daemon so they become searchable with the clued tools.
set -u
[ -n "\${REMEMBER_DIR:-}" ] || exit 0
exec "${CLUED}" session memory-ingest --dir "\$REMEMBER_DIR" --cwd "\${PROJECT_DIR:-\$PWD}" --quiet
SCRIPT
}

installed=0
while IFS= read -r root; do
  [[ -n "$root" && -d "${root}/hooks.d" ]] || continue
  for event in after_save after_consolidate; do
    dir="${root}/hooks.d/${event}"
    [[ -d "$dir" ]] || continue
    target="${dir}/${LISTENER_NAME}"
    body="$(listener_body)"
    if [[ -f "$target" ]] && [[ "$(cat "$target")" == "$body" ]]; then
      chmod 0755 "$target" 2>/dev/null
      continue
    fi
    tmp="${target}.tmp.$$"
    if printf '%s\n' "$body" > "$tmp" && chmod 0755 "$tmp" && mv -f "$tmp" "$target"; then
      installed=$((installed + 1))
    else
      rm -f "$tmp"
      echo "clued: could not install the claude-remember listener at ${target}" >&2
    fi
  done
done < <(remember_roots | awk '!seen[$0]++')
exit 0
