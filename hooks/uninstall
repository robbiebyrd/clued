#!/usr/bin/env bash
# Non-interactive cleanup for clued services and optional artefacts.
# Usage: uninstall [--keep-config] [--keep-mongo-binary]
#
# Local mode (no serverUrl): stops the daemon when one answers on its port.
# Remote mode (serverUrl set, or CLUED_SERVER_URL): there is no daemon, so
#          nothing is probed or stopped.
# Always:  removes the hook relay's catch-up state (<data dir>/catchup/) and
#          its log (<data dir>/relay.log), even with --keep-config
# macOS:   unloads and removes ~/Library/LaunchAgents/org.mongodb.mongod.plist
#          when it is present (a local MongoDB install)
# Server stack (`mind-palace server init` under ~/.clued-server or
#          $CLUED_SERVER_DIR): stops its containers with `docker compose
#          down` (docker-compose.yml) or down.sh (Apple Containers, which
#          also removes the launchd agent); the MongoDB volume and the
#          directory (tokens, certificates) stay unless --purge-server,
#          which also takes the stack's CA out of this machine's trust
#          stores (`server trust --remove`)
# Flags:
#   --keep-config          skip removing ~/.claude/plugins/data/clued/
#   --keep-mongo-binary    skip removing ~/mongodb/ (tarball install only)
#   --keep-server          leave the server stack running
#   --purge-server         also remove the stack's MongoDB volume (every
#                          session, plan and story on the server) and its
#                          directory
#
# Every step is skipped silently when the thing it removes is absent. The
# plugin itself stays installed (only Claude Code can remove it); the last
# lines say how.

KEEP_CONFIG=0
KEEP_MONGO_BINARY=0
KEEP_SERVER=0
PURGE_SERVER=0
for arg in "$@"; do
  case "$arg" in
    --keep-config)         KEEP_CONFIG=1 ;;
    --keep-mongo-binary)   KEEP_MONGO_BINARY=1 ;;
    --keep-server)         KEEP_SERVER=1 ;;
    --purge-server)        PURGE_SERVER=1 ;;
  esac
done

DATA_DIR="${HOME}/.claude/plugins/data/clued"
CONFIG_FILE="${DATA_DIR}/config.json"
DEFAULT_PORT=8085

SERVER_URL=""
if command -v jq &>/dev/null && [[ -f "$CONFIG_FILE" ]]; then
  PORT=$(jq -r ".port // ${DEFAULT_PORT}" "$CONFIG_FILE" 2>/dev/null || echo "$DEFAULT_PORT")
  SERVER_URL=$(jq -r '.serverUrl // empty' "$CONFIG_FILE" 2>/dev/null)
else
  PORT=$DEFAULT_PORT
fi
PORT="${CLUED_PORT:-$PORT}"
SERVER_URL="${CLUED_SERVER_URL:-$SERVER_URL}"

# --- Stop daemon (local mode only; remote mode never started one) ---
if [[ -z "$SERVER_URL" ]] && command -v curl &>/dev/null \
  && curl -sf --max-time 1 "http://127.0.0.1:${PORT}/health" &>/dev/null; then
  pkill -f 'mind-palace session daemon$' 2>/dev/null && echo "clued: daemon stopped" || true
fi

# --- The server stack this machine hosts (from `server init`: docker compose, or down.sh on Apple Containers) ---
# untrust_stack_ca takes the stack's CA out of this machine's trust stores
# (`server trust --remove`) before its directory goes. What it cannot do
# (root, a keychain dialog) is printed, and the CA is kept as
# ~/clued-server-ca.pem so those commands still find it.
untrust_stack_ca() {
  local ca="${STACK_DIR}/tls/ca.pem" shim out pending
  [[ -f "$ca" ]] || return 0
  shim="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/scripts/clued"
  if out=$("$shim" server trust --remove --dir "$STACK_DIR" 2>/dev/null); then
    pending=""
    command -v jq &>/dev/null && pending=$(jq -r '.result.pending[]?' <<<"$out" 2>/dev/null)
    if [[ -z "$pending" ]]; then
      echo "clued: removed the server CA from this machine's trust stores"
      return 0
    fi
    cp "$ca" "${HOME}/clued-server-ca.pem"
    echo "clued: to finish removing the server CA from the trust stores, run (it was kept as ~/clued-server-ca.pem):"
    printf '  %s\n' "${pending//${ca}/${HOME}/clued-server-ca.pem}"
  else
    cp "$ca" "${HOME}/clued-server-ca.pem"
    echo "clued: could not take the server CA out of the trust stores; it was kept as ~/clued-server-ca.pem: run \`scripts/clued server trust --remove --ca ~/clued-server-ca.pem\`" >&2
  fi
}

STACK_DIR="${CLUED_SERVER_DIR:-${HOME}/.clued-server}"
STACK_COMPOSE="${STACK_DIR}/docker-compose.yml"
STACK_DOWN="${STACK_DIR}/down.sh"
STACK_FILE=""
if [[ $KEEP_SERVER -eq 0 ]]; then
  if [[ -f "$STACK_DOWN" ]]; then
    STACK_FILE="$STACK_DOWN"
    stack_down() { bash "$STACK_DOWN" "$@" &>/dev/null; }
  elif [[ -f "$STACK_COMPOSE" ]] && command -v docker &>/dev/null; then
    STACK_FILE="$STACK_COMPOSE"
    stack_down() { docker compose -f "$STACK_COMPOSE" down "$@" &>/dev/null; }
  fi
fi
if [[ -n "$STACK_FILE" ]]; then
  if [[ $PURGE_SERVER -eq 1 ]]; then
    if stack_down --volumes; then
      untrust_stack_ca
      rm -rf "$STACK_DIR"
      echo "clued: server stack stopped and removed with its data (${STACK_DIR})"
    else
      echo "clued: could not stop the server stack (${STACK_FILE}); is its container runtime running?" >&2
    fi
  elif stack_down; then
    echo "clued: server stack stopped (its data volume and ${STACK_DIR} are kept; --purge-server removes them)"
  else
    echo "clued: could not stop the server stack (${STACK_FILE}); is its container runtime running?" >&2
  fi
fi

# --- macOS launchd plist ---
PLIST=~/Library/LaunchAgents/org.mongodb.mongod.plist
if [[ "$(uname -s)" == "Darwin" && -f "$PLIST" ]]; then
  launchctl unload "$PLIST" 2>/dev/null || true
  rm "$PLIST"
  echo "clued: removed launchd plist"
fi

# --- Hook relay state: catch-up offsets and lock files, and the failure log ---
# Both are runtime state, not configuration, so they go even with --keep-config;
# the next relay starts its catch-up from offset 0, which is idempotent.
if [[ -d "${DATA_DIR}/catchup" ]]; then
  rm -rf "${DATA_DIR}/catchup"
  echo "clued: removed catch-up state"
fi
if [[ -f "${DATA_DIR}/relay.log" ]]; then
  rm -f "${DATA_DIR}/relay.log"
  echo "clued: removed relay log"
fi

# --- The status line: put back the command clued's replaced (register-hooks kept it) ---
SETTINGS="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}/settings.json"
if command -v jq &>/dev/null && [[ -f "$SETTINGS" ]]; then
  current=$(jq -r '.statusLine.command // empty' "$SETTINGS" 2>/dev/null)
  if [[ "$current" == *"/scripts/clued hook status"* ]]; then
    then=$(jq -r '.then // empty' "${DATA_DIR}/statusline.json" 2>/dev/null)
    TMP="${SETTINGS}.tmp.$$"
    if [[ -n "$then" ]]; then
      jq --arg cmd "$then" '.statusLine.command = $cmd' "$SETTINGS" > "$TMP" && mv "$TMP" "$SETTINGS"
    else
      jq 'del(.statusLine)' "$SETTINGS" > "$TMP" && mv "$TMP" "$SETTINGS"
    fi
    rm -f "${DATA_DIR}/statusline.json"
    echo "clued: status line restored"
  fi
fi

# --- Config, data and the bin/ dir with the downloaded release binary (inside the data dir) ---
if [[ $KEEP_CONFIG -eq 0 && -d "$DATA_DIR" ]]; then
  rm -rf "$DATA_DIR"
  echo "clued: removed config dir and binary dir"
fi

# --- MongoDB tarball binaries ---
if [[ $KEEP_MONGO_BINARY -eq 0 && -d "${HOME}/mongodb" ]]; then
  rm -rf "${HOME}/mongodb"
  echo "clued: removed mongodb binaries (~/mongodb)"
fi

# --- The plugin itself: only Claude Code can remove it ---
echo "clued: the plugin is still installed; remove it with \`/plugin uninstall clued@clued\` in Claude Code (or \`claude plugin uninstall clued@clued\`), then /reload-plugins"
echo "clued: uninstall complete"
