#!/usr/bin/env bash
# Non-interactive cleanup for clued services and optional artefacts.
# Usage: uninstall [--keep-config] [--keep-mongo-binary]
#
# Local mode (no serverUrl): stops the daemon when one answers on its port.
# Remote mode (serverUrl set, or CLUED_SERVER_URL): there is no daemon, so
#          nothing is probed or stopped.
# Always:  removes the hook relay's catch-up state (<data dir>/catchup/) and
#          its log (<data dir>/relay.log), even with --keep-config
# macOS:   unloads and removes ~/Library/LaunchAgents/org.mongodb.mongod.plist
#          when it is present (a local MongoDB install)
# Server stack (`mind-palace server init`, ~/.clued-server/docker-compose.yml
#          or $CLUED_SERVER_DIR): stops its containers with `docker compose
#          down`; the MongoDB volume and the directory (tokens, certificates)
#          stay unless --purge-server
# Flags:
#   --keep-config          skip removing ~/.claude/plugins/data/clued/
#   --keep-mongo-binary    skip removing ~/mongodb/ (tarball install only)
#   --keep-server          leave the server stack running
#   --purge-server         also remove the stack's MongoDB volume (every
#                          session, plan and story on the server) and its
#                          directory
#
# Every step is skipped silently when the thing it removes is absent.

KEEP_CONFIG=0
KEEP_MONGO_BINARY=0
KEEP_SERVER=0
PURGE_SERVER=0
for arg in "$@"; do
  case "$arg" in
    --keep-config)         KEEP_CONFIG=1 ;;
    --keep-mongo-binary)   KEEP_MONGO_BINARY=1 ;;
    --keep-server)         KEEP_SERVER=1 ;;
    --purge-server)        PURGE_SERVER=1 ;;
  esac
done

DATA_DIR="${HOME}/.claude/plugins/data/clued"
CONFIG_FILE="${DATA_DIR}/config.json"
DEFAULT_PORT=8085

SERVER_URL=""
if command -v jq &>/dev/null && [[ -f "$CONFIG_FILE" ]]; then
  PORT=$(jq -r ".port // ${DEFAULT_PORT}" "$CONFIG_FILE" 2>/dev/null || echo "$DEFAULT_PORT")
  SERVER_URL=$(jq -r '.serverUrl // empty' "$CONFIG_FILE" 2>/dev/null)
else
  PORT=$DEFAULT_PORT
fi
PORT="${CLUED_PORT:-$PORT}"
SERVER_URL="${CLUED_SERVER_URL:-$SERVER_URL}"

# --- Stop daemon (local mode only; remote mode never started one) ---
if [[ -z "$SERVER_URL" ]] && command -v curl &>/dev/null \
  && curl -sf --max-time 1 "http://127.0.0.1:${PORT}/health" &>/dev/null; then
  pkill -f 'mind-palace session daemon$' 2>/dev/null && echo "clued: daemon stopped" || true
fi

# --- The server stack this machine hosts (docker compose, from `server init`) ---
STACK_DIR="${CLUED_SERVER_DIR:-${HOME}/.clued-server}"
STACK_COMPOSE="${STACK_DIR}/docker-compose.yml"
if [[ $KEEP_SERVER -eq 0 && -f "$STACK_COMPOSE" ]] && command -v docker &>/dev/null; then
  if [[ $PURGE_SERVER -eq 1 ]]; then
    if docker compose -f "$STACK_COMPOSE" down --volumes &>/dev/null; then
      rm -rf "$STACK_DIR"
      echo "clued: server stack stopped and removed with its data (${STACK_DIR})"
    else
      echo "clued: could not stop the server stack (${STACK_COMPOSE}); is Docker running?" >&2
    fi
  elif docker compose -f "$STACK_COMPOSE" down &>/dev/null; then
    echo "clued: server stack stopped (its data volume and ${STACK_DIR} are kept; --purge-server removes them)"
  else
    echo "clued: could not stop the server stack (${STACK_COMPOSE}); is Docker running?" >&2
  fi
fi

# --- macOS launchd plist ---
PLIST=~/Library/LaunchAgents/org.mongodb.mongod.plist
if [[ "$(uname -s)" == "Darwin" && -f "$PLIST" ]]; then
  launchctl unload "$PLIST" 2>/dev/null || true
  rm "$PLIST"
  echo "clued: removed launchd plist"
fi

# --- Hook relay state: catch-up offsets and lock files, and the failure log ---
# Both are runtime state, not configuration, so they go even with --keep-config;
# the next relay starts its catch-up from offset 0, which is idempotent.
if [[ -d "${DATA_DIR}/catchup" ]]; then
  rm -rf "${DATA_DIR}/catchup"
  echo "clued: removed catch-up state"
fi
if [[ -f "${DATA_DIR}/relay.log" ]]; then
  rm -f "${DATA_DIR}/relay.log"
  echo "clued: removed relay log"
fi

# --- Config, data and the bin/ dir with the downloaded release binary (inside the data dir) ---
if [[ $KEEP_CONFIG -eq 0 && -d "$DATA_DIR" ]]; then
  rm -rf "$DATA_DIR"
  echo "clued: removed config dir and binary dir"
fi

# --- MongoDB tarball binaries ---
if [[ $KEEP_MONGO_BINARY -eq 0 && -d "${HOME}/mongodb" ]]; then
  rm -rf "${HOME}/mongodb"
  echo "clued: removed mongodb binaries (~/mongodb)"
fi

echo "clued: uninstall complete"
