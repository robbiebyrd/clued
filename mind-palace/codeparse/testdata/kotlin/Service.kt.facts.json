      },
      "end": {
        "line": 50,
        "column": 1,
        "offset": 1423
      },
      "text": "object Registry : BaseService(\"registry\"), PricedItem {\n    override val price: Long = 0\n    override fun discounted(percent: Int): Long = price * (100 - percent) / 100\n    override fun start() = Unit\n}",
      "hash": "31aa73b0a7acb8e5e8ab416888a116e7a9295352704aa4c76fbcc6147bff6b8b"
    },
