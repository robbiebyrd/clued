      "text": "package com.example.shop.service\n\nimport com.example.shop.model.Customer\nimport com.example.shop.model.Priced as PricedItem\nimport com.example.shop.model.*\nimport kotlinx.coroutines.flow.Flow\nimport java.io.Closeable",
      "hash": "6025cb16176c720dfbc30e54b73abd10026923c2edfafbf24595aea41d25a7ac"
    },
    {
      "id": "com.example.shop.service.Repository#1",
      "kind": "symbol",
      "symbolId": "com.example.shop.service.Repository",
      "start": {
        "line": 9,
        "column": 0,
        "offset": 218
      },
      "end": {
        "line": 13,
        "column": 1,
        "offset": 365
      },
      "text": "/** Stores customers. */\ninterface Repository\u003cT\u003e : Closeable, java.lang.AutoCloseable {\n    suspend fun find(id: Long): T?\n    fun all(): Flow\u003cT\u003e\n}",
      "hash": "4ce369456871e610156d488baf6a31bdcd3923d35925088d4bf06725c13fb247"
    },
    {
      "id": "com.example.shop.service.BaseService#1",
      "kind": "symbol",
      "symbolId": "com.example.shop.service.BaseService",
      "start": {
        "line": 15,
        "column": 0,
        "offset": 367
      },
      "end": {
        "line": 17,
        "column": 1,
        "offset": 450
      },
      "text": "abstract class BaseService(protected val name: String) {\n    abstract fun start()\n}",
      "hash": "aec8784f7568659fda7e9d47fbcf15d248d6f359d7a90d22cb40d89e4281aaf5"
    },
    {
      "id": "com.example.shop.service.CustomerService#1",
      "kind": "symbol",
      "symbolId": "com.example.shop.service.CustomerService",
      "start": {
        "line": 19,
        "column": 0,
        "offset": 452
      },
      "end": {
        "line": 44,
        "column": 1,
        "offset": 1219
      },
      "text": "class CustomerService(\n    private val repo: Repository\u003cCustomer\u003e,\n    private val clock: java.time.Clock,\n) : BaseService(\"customers\"), Repository\u003cCustomer\u003e by repo, AutoCloseable {\n\n    override fun start() {\n        val now = clock.instant()\n        log(\"started at $now\")\n        Catalog.price(\"sku-1\")\n    }\n\n    suspend fun rename(id: Long, name: String): Customer? {\n        val customer = repo.find(id) ?: return null\n        customer.name = name\n        val copy: Customer = customer.copy(name = name)\n        return validate(copy)?.let { Customer.of(it.name) }\n    }\n\n    private fun validate(c: Customer): Customer? =\n        if (c.name.length \u003c= Customer.MAX_NAME) c else null\n\n    override fun close() {\n        super.close()\n        repo.close()\n    }\n}",
      "hash": "641dcb323009534111cdfd96c3087b5a4c5db579ade1fe42178955a876f9d711"
    },
    {
      "id": "com.example.shop.service.Registry#1",
