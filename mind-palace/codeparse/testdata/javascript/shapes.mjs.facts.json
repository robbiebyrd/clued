      },
      "text": "// Shapes: an ES module with every kind of definition JavaScript has.\n\nimport { EventEmitter } from 'node:events';\nimport * as geometry from './geometry.mjs';\n\n/** The default precision of every area, in decimal places. */\nexport const PRECISION = 2;\n\n/** How many shapes were made; not exported. */\nlet created = 0;\n\nvar registry = new Map();",
      "hash": "bdd3bd51ec2e80b16ffa8085028e39b1e1895c8e4cbad889e249b893bb04d034"
    },
    {
      "id": "Shape#1",
      "kind": "symbol",
      "symbolId": "Shape",
      "start": {
        "line": 14,
        "column": 0,
        "offset": 345
      },
      "end": {
        "line": 64,
        "column": 1,
        "offset": 1221
      },
      "text": "/**\n * Shape is the base of every shape.\n * It counts the shapes it makes.\n */\nexport class Shape extends EventEmitter {\n  /** The shape's name. */\n  name = 'shape';\n  static #count = 0;\n  #id;\n\n  constructor(name) {\n    super();\n    this.name = name;\n    this.#id = Shape.#count++;\n    created++;\n  }\n\n  /** Area of the shape; subclasses override it. */\n  area() {\n    throw new Error('not implemented');\n  }\n\n  get id() {\n    return this.#id;\n  }\n\n  set label(value) {\n    this.name = String(value);\n  }\n\n  static create(kind, ...args) {\n    return new kinds[kind](...args);\n  }\n\n  #describe() {\n    return `${this.name} #${this.#id}`;\n  }\n\n  toString() {\n    return this.#describe();\n  }\n\n  // An arrow function in a field is a method bound to the instance.\n  onResize = (event) =\u003e {\n    this.emit('resize', event);\n  };\n\n  *[Symbol.iterator]() {\n    yield this.name;\n  }\n}",
      "hash": "7795102ba8cfcfc79b65abc43ab0217cc94fb721fcf8ab9f83d9cf2f1821de82"
    },
    {
      "id": "Circle#1",
      "kind": "symbol",
      "symbolId": "Circle",
      "start": {
        "line": 66,
        "column": 0,
        "offset": 1223
      },
      "end": {
        "line": 76,
        "column": 1,
        "offset": 1406
      },
      "text": "/** A circle of radius r. */\nexport class Circle extends Shape {\n  constructor(r) {\n    super('circle');\n    this.r = r;\n  }\n\n  area() {\n    return round(Math.PI * this.r ** 2);\n  }\n}",
      "hash": "33dcfe73024f813d487d0943244174bdb472b88f18f05a65325d6c4a588894b1"
    },
    {
      "id": "Square#1",
      "kind": "symbol",
      "symbolId": "Square",
      "start": {
        "line": 78,
        "column": 0,
        "offset": 1408
      },
      "end": {
        "line": 82,
        "column": 1,
        "offset": 1511
      },
      "text": "class Square extends geometry.Polygon {\n  area() {\n    return round(geometry.squared(this.side));\n  }\n}",
      "hash": "6dd5c132895452b7fcb5f93e037189655aa4b9a84c4b3a25937f3ac29381e2a6"
    },
    {
      "id": "L84#1",
      "kind": "window",
      "start": {
        "line": 84,
        "column": 0,
        "offset": 1513
      },
      "end": {
        "line": 84,
        "column": 49,
        "offset": 1562
      },
      "text": "const kinds = { circle: Circle, square: Square };",
      "hash": "d6cba4d6ded05fff80354a8accfa6771619f91aa9432ca3affa7f0c13af15c3b"
    },
    {
      "id": "round#1",
      "kind": "symbol",
      "symbolId": "round",
      "start": {
        "line": 86,
        "column": 0,
        "offset": 1564
      },
      "end": {
        "line": 90,
        "column": 1,
        "offset": 1690
      },
      "text": "/** Rounds x to PRECISION places. */\nexport function round(x) {\n  const f = 10 ** PRECISION;\n  return Math.round(x * f) / f;\n}",
      "hash": "ca23f4e2486af7e30639b5018c93866d56c3c26389bc1188c39c5ad0bcaa27fb"
    },
