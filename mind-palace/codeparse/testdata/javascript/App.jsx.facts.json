      },
      "text": "import React, { useState, useEffect as useMountEffect } from 'react';\nimport PropTypes from 'prop-types';\nimport * as UI from './ui';\nimport Button from './Button.jsx';\nimport './App.css';",
      "hash": "605221574194485f56a7653e1e9bf49b71cdae88e78d9e03f44d6eddd8a8ec6a"
    },
    {
      "id": "Greeting#1",
      "kind": "symbol",
      "symbolId": "Greeting",
      "start": {
        "line": 7,
        "column": 0,
        "offset": 190
      },
      "end": {
        "line": 10,
        "column": 1,
        "offset": 321
      },
      "text": "/** Greeting renders a name in a heading. */\nfunction Greeting({ name }) {\n  return \u003ch1 className=\"greeting\"\u003eHello, {name}!\u003c/h1\u003e;\n}",
      "hash": "e5e842cd83facaca566f422812a1d3ffbac0f38bef7441e986552b6bb57a88bd"
    },
    {
      "id": "L12#1",
      "kind": "window",
      "start": {
        "line": 12,
        "column": 0,
        "offset": 323
      },
      "end": {
        "line": 12,
        "column": 59,
        "offset": 382
      },
      "text": "Greeting.propTypes = { name: PropTypes.string.isRequired };",
      "hash": "312f6df297154e43716ffc59f3413bab808ada352772944769207d1f5f9cc936"
    },
    {
      "id": "TodoList#1",
      "kind": "symbol",
      "symbolId": "TodoList",
      "start": {
        "line": 14,
        "column": 0,
        "offset": 384
      },
      "end": {
        "line": 24,
        "column": 1,
        "offset": 700
      },
      "text": "/** TodoList shows the items and a button that adds one. */\nexport const TodoList = ({ items, onAdd }) =\u003e (\n  \u003cUI.Panel title=\"Todo\"\u003e\n    \u003cul\u003e\n      {items.map((item) =\u003e (\n        \u003cTodoItem key={item.id} {...item} /\u003e\n      ))}\n    \u003c/ul\u003e\n    \u003cButton onClick={() =\u003e onAdd(prompt('What?'))}\u003eAdd\u003c/Button\u003e\n  \u003c/UI.Panel\u003e\n)",
      "hash": "e437f73a7a02191c0f2ce133528a074a6ea5a906dbec5c88d0585dfc8248022d"
    },
    {
      "id": "L26#1",
      "kind": "window",
      "start": {
        "line": 26,
        "column": 0,
        "offset": 703
      },
      "end": {
        "line": 28,
        "column": 3,
        "offset": 829
      },
      "text": "const TodoItem = React.memo(function TodoItem({ title, done }) {\n  return \u003cli className={done ? 'done' : ''}\u003e{title}\u003c/li\u003e;\n});",
      "hash": "4b1a55bc42c80e549068236e9ac0a179cd2dd5f26c8215335dc6473a3b0ee20f"
    },
    {
      "id": "App#1",
      "kind": "symbol",
      "symbolId": "App",
      "start": {
        "line": 30,
        "column": 15,
        "offset": 846
      },
      "end": {
        "line": 42,
        "column": 1,
        "offset": 1183
      },
      "text": "function App() {\n  const [items, setItems] = useState([]);\n  useMountEffect(() =\u003e {\n    loadItems().then(setItems);\n  }, []);\n  const add = (title) =\u003e setItems([...items, { id: items.length, title }]);\n  return (\n    \u003cReact.Fragment\u003e\n      \u003cGreeting name=\"you\" /\u003e\n      \u003cTodoList items={items} onAdd={add} /\u003e\n    \u003c/React.Fragment\u003e\n  );\n}",
      "hash": "6ba5b2d0ed3d6f7716a060817730f33ac94e12a1fc51467c358bd57c63a6451e"
    },
    {
      "id": "ErrorBoundary#1",
      "kind": "symbol",
      "symbolId": "ErrorBoundary",
      "start": {
        "line": 44,
        "column": 0,
        "offset": 1185
      },
      "end": {
        "line": 54,
        "column": 1,
        "offset": 1429
      },
      "text": "class ErrorBoundary extends React.Component {\n  state = { failed: false };\n\n  static getDerivedStateFromError() {\n    return { failed: true };\n  }\n\n  render() {\n    return this.state.failed ? \u003cp\u003eSomething broke.\u003c/p\u003e : this.props.children;\n  }\n}",
      "hash": "64c1ca6c29c467b3e5095845f025126beec7d7054816ed8a625bca82d07cd3fd"
    },
    {
      "id": "loadItems#1",
      "kind": "symbol",
      "symbolId": "loadItems",
      "start": {
        "line": 56,
        "column": 0,
        "offset": 1431
      },
      "end": {
        "line": 59,
        "column": 1,
        "offset": 1535
      },
      "text": "async function loadItems() {\n  const { fetchItems } = await import('./api.js');\n  return fetchItems();\n}",
      "hash": "2452c01c92ffc87755448d28c34253cd83c564d201f32b42d52bbb3e1c01480c"
    },
