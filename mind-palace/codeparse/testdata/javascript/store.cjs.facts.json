      "text": "'use strict';\n\n// A key-value store in CommonJS: require, module.exports and prototypes.\n\nconst fs = require('fs');\nconst path = require('node:path');\nconst { promisify, inspect: show } = require('util');\nconst debug = require('debug')('store');\nrequire('./polyfills');\n\nconst readFile = promisify(fs.readFile);",
      "hash": "a2ed11ee3e34e7dbf5830527d7d28719804e856896be68f44bb2991f0cb2ba75"
    },
    {
      "id": "Store#1",
      "kind": "symbol",
      "symbolId": "Store",
      "start": {
        "line": 13,
        "column": 0,
        "offset": 313
      },
      "end": {
        "line": 21,
        "column": 1,
        "offset": 566
      },
      "text": "/**\n * Store keeps values by key, in memory and on disk.\n * @param {string} dir where the store writes\n */\nfunction Store(dir) {\n  if (!(this instanceof Store)) return new Store(dir);\n  this.dir = path.resolve(dir);\n  this.cache = Object.create(null);\n}",
      "hash": "6f9f0fa37fb9ba8382d64483c83f5b94ae8bb933e065f8fe8066c87928b7c795"
    },
    {
      "id": "Store.get#1",
      "kind": "symbol",
      "symbolId": "Store.get",
      "start": {
        "line": 23,
        "column": 0,
        "offset": 568
      },
      "end": {
        "line": 28,
        "column": 1,
        "offset": 830
      },
      "text": "/** Get returns the value of key, reading it from disk once. */\nStore.prototype.get = async function get(key) {\n  if (key in this.cache) return this.cache[key];\n  const raw = await readFile(this.file(key), 'utf8');\n  return (this.cache[key] = JSON.parse(raw));\n}",
      "hash": "70492b2e1c2ee7506db6e17a35e12af6a8537096309f1816d8c0260c88aba587"
    },
    {
      "id": "Store.file#1",
      "kind": "symbol",
      "symbolId": "Store.file",
      "start": {
        "line": 30,
        "column": 0,
        "offset": 833
      },
      "end": {
        "line": 32,
        "column": 1,
        "offset": 929
      },
      "text": "Store.prototype.file = function (key) {\n  return path.join(this.dir, encodeURIComponent(key));\n}",
      "hash": "4e58bdcdc7e51c34cc80e431f66e500da50f398646218d08fec11313901e4af1"
    },
    {
      "id": "Store.toString#1",
      "kind": "symbol",
      "symbolId": "Store.toString",
      "start": {
        "line": 34,
        "column": 0,
        "offset": 932
      },
      "end": {
        "line": 34,
        "column": 43,
        "offset": 975
      },
      "text": "Store.prototype.toString = () =\u003e show(this)",
      "hash": "829a9ef2700acfa1b28e876bd15c1e36b53103e657c1c5aea20cfb016b41023d"
    },
    {
      "id": "memoize#1",
      "kind": "symbol",
      "symbolId": "memoize",
      "start": {
        "line": 36,
        "column": 0,
        "offset": 978
      },
      "end": {
        "line": 44,
        "column": 1,
        "offset": 1205
      },
      "text": "function memoize(fn) {\n  const seen = new Map();\n  // A closure defined inside a function nests under it.\n  function lookup(arg) {\n    if (!seen.has(arg)) seen.set(arg, fn(arg));\n    return seen.get(arg);\n  }\n  return lookup;\n}",
      "hash": "6ce3e3d552643af479e8f7af7ffe2341d1ca513349f04819274943b5603420aa"
    },
    {
      "id": "open#1",
      "kind": "symbol",
      "symbolId": "open",
      "start": {
        "line": 46,
        "column": 0,
        "offset": 1207
      },
      "end": {
        "line": 50,
        "column": 1,
        "offset": 1370
      },
      "text": "/** Opens a store under the user's home. */\nexports.open = function open(name) {\n  debug('open %s', name);\n  return new Store(path.join(process.env.HOME, name));\n}",
      "hash": "ad6c7541224d6ff2d1202319a4a1ecc9720e19d9be6d375965cab1db518b1979"
    },
    {
      "id": "close#1",
      "kind": "symbol",
      "symbolId": "close",
      "start": {
        "line": 52,
        "column": 0,
        "offset": 1373
      },
      "end": {
        "line": 54,
        "column": 1,
        "offset": 1432
      },
      "text": "module.exports.close = (store) =\u003e {\n  store.cache = null;\n}",
      "hash": "e91a5ae00059deebf36b5d3bfd4223cca8e3cea806768b3e6e5c4c8e9ea5293d"
    },
    {
      "id": "L56#1",
      "kind": "window",
      "start": {
        "line": 56,
