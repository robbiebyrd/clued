      },
      "end": {
        "line": 63,
        "column": 10,
        "offset": 1566
      },
      "text": "exports.VERSION = '1.4.0';\n\nmodule.exports.Store = Store;\nmodule.exports.memoize = memoize;\n\nmodule.exports = {\n  Store,\n  memoize,",
      "hash": "e218885056edfc99724dc45297a17720e1ba14fc3fef33e03cab9236cad8c7dd"
    },
    {
      "id": "clear#1",
