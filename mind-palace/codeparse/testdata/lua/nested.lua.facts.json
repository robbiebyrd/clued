      },
      "text": "-- Awkward cases: nested tables, deep field paths, closures, long strings,\n-- goto and a generated table of handlers.\n\nlocal app = { handlers = {}, util = {} }",
      "hash": "a54827f8de74ef5d2c453c09ee1d1dc422dc6c70d70f3f9099358ad284faa3c2"
    },
    {
      "id": "app.util.escape#1",
      "kind": "symbol",
      "symbolId": "app.util.escape",
      "start": {
        "line": 6,
        "column": 0,
        "offset": 161
      },
      "end": {
        "line": 10,
        "column": 3,
        "offset": 286
      },
      "text": "function app.util.escape(s)\n  return (s:gsub(\"[%c\\\"\\\\]\", function(c)\n    return string.format(\"\\\\%03d\", c:byte())\n  end))\nend",
      "hash": "bdd8ce01db6d8c850495968467e0c1132518e8003f1c65a8de0cf2508ca570bf"
    },
    {
      "id": "app.handlers.get#1",
      "kind": "symbol",
      "symbolId": "app.handlers.get",
      "start": {
        "line": 12,
        "column": 0,
        "offset": 288
      },
      "end": {
        "line": 18,
        "column": 3,
        "offset": 446
      },
      "text": "function app.handlers.get(req)\n  local function inner(x)\n    local function innermost() return x end\n    return innermost()\n  end\n  return inner(req.path)\nend",
      "hash": "5635202c4a77daf04d18a5e0b9b8a924e0dc51b6f0ac08523ad114183a50aa1d"
    },
    {
      "id": "L20#1",
      "kind": "window",
      "start": {
        "line": 20,
        "column": 0,
        "offset": 448
      },
      "end": {
        "line": 34,
        "column": 13,
        "offset": 770
      },
      "text": "app.handlers[\"post\"] = function(req) return req end\n\nlocal template = [==[\nfunction not_a_function() end\nlocal x = require(\"not.an.import\")\n]==]\n\n-- Generated: one handler per verb.\nfor _, verb in ipairs({ \"put\", \"delete\" }) do\n  app.handlers[verb] = function(req)\n    return app.handlers.get(req)\n  end\nend\n\nlocal ops = {",
      "hash": "20ed94197c2a2cb3bb62001ca9b72274e3f56c9c48e40ac168ee4cca6a198e7e"
    },
    {
      "id": "ops.add#1",
      "kind": "symbol",
      "symbolId": "ops.add",
      "start": {
        "line": 35,
        "column": 0,
        "offset": 771
      },
      "end": {
        "line": 35,
        "column": 39,
        "offset": 810
      },
      "text": "  add = function(a, b) return a + b end",
      "hash": "a86040137534288c931f5c04fbf768c7b66d3c7c49b99942b4267a4ae0ea98d5"
    },
    {
      "id": "ops.sub#1",
      "kind": "symbol",
      "symbolId": "ops.sub",
      "start": {
        "line": 36,
        "column": 0,
        "offset": 812
      },
      "end": {
        "line": 36,
        "column": 39,
        "offset": 851
      },
      "text": "  sub = function(a, b) return a - b end",
      "hash": "6c74c5b144058af6c4bbf91974ee8ed059f6b055f620cca7fda249eee3d63cba"
    },
    {
      "id": "L37#1",
      "kind": "window",
      "start": {
        "line": 37,
        "column": 0,
        "offset": 853
      },
      "end": {
        "line": 40,
        "column": 1,
        "offset": 915
      },
      "text": "  nested = {\n    mul = function(a, b) return a * b end,\n  },\n}",
      "hash": "fd355962ce8f3e1ab99d28b5a9e4f30cdbf5975b0cec6165e3adbad892927519"
    },
    {
      "id": "loop#1",
      "kind": "symbol",
      "symbolId": "loop",
      "start": {
        "line": 42,
        "column": 0,
        "offset": 917
      },
      "end": {
        "line": 50,
        "column": 3,
        "offset": 1068
      },
      "text": "local function loop(n)\n  local i = 1\n  ::top::\n  if i \u003c n then\n    i = i + 1\n    goto top\n  end\n  return ops.nested.mul(i, ops.add(1, 2)), template\nend",
      "hash": "ef4473ed3c454d9e7d860fdb31877a196adecf76d859400f1e80a211bf9652a1"
    },
    {
      "id": "L52#1",
