      },
      "end": {
        "line": 27,
        "column": 75,
        "offset": 737
      },
      "text": "local data = fetch(\"https://example.com/data.json\")\ninsert(data, socket.gettime())\nprint(lpeg.match(re.compile(\"%a+\"), \"abc\"), ok and lfs.currentdir(), chunk)",
      "hash": "908a69f0f684252e9c7ee3674dd372f4d742fd618442b7239ef8d255c873b1c4"
