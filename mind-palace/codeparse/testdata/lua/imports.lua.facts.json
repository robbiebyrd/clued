      },
      "text": "-- Every way a Lua file pulls in another.\nrequire \"busted.runner\"\nrequire(\"luarocks.loader\")\nrequire 'strict'\n\nlocal json = require(\"cjson\")\nlocal socket = require \"socket\"\nlocal http = require(\"socket.http\")\nlocal insert = require(\"table\").insert\nlocal lpeg, re = require(\"lpeg\"), require(\"re\")\n\nlocal ok, lfs = pcall(require, \"lfs\")\n\ndofile(\"config.lua\")\nlocal chunk = loadfile(\"plugins/init.lua\")",
      "hash": "f3217145e32ee7b1ab83a7f4e3b3769b76cf0f09fa80aca88520eb335db86e13"
    },
    {
      "id": "fetch#1",
      "kind": "symbol",
      "symbolId": "fetch",
      "start": {
        "line": 17,
        "column": 0,
        "offset": 401
      },
      "end": {
        "line": 23,
        "column": 3,
        "offset": 577
      },
      "text": "local function fetch(url)\n  local body, code = http.request(url)\n  if code ~= 200 then\n    error(\"fetch \" .. url .. \": \" .. tostring(code))\n  end\n  return json.decode(body)\nend",
      "hash": "2a8e95a0b001d5f88a162cbe24e4f6f6e25c78edb148f63f39e748c4466dbba0"
    },
    {
      "id": "L25#1",
      "kind": "window",
      "start": {
        "line": 25,
        "column": 0,
