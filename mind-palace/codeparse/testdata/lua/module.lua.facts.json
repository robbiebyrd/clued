      "text": "-- Copyright 2026 Example. A file header, not a doc comment.\n\n--- A small string utility module.\n-- @module strutil\nlocal strutil = {\n  --- The module's version.\n  VERSION = \"1.2.0\",\n  sep = \",\",",
      "hash": "85074f5423847c31cfe8895a3cfc9465a6ec5a603e96c30a2bdba183f292ce4c"
    },
    {
      "id": "strutil.trim#1",
      "kind": "symbol",
      "symbolId": "strutil.trim",
      "start": {
        "line": 9,
        "column": 0,
        "offset": 196
      },
      "end": {
        "line": 12,
        "column": 5,
        "offset": 316
      },
      "text": "  --- Trims white space from both ends of s.\n  trim = function(s)\n    return (s:gsub(\"^%s+\", \"\"):gsub(\"%s+$\", \"\"))\n  end",
      "hash": "451e57ff02f973a8cd6b72f2ca50763b9bf9623313c09604599dbdb00a7b2fdf"
    },
    {
      "id": "L13#1",
      "kind": "window",
      "start": {
        "line": 13,
        "column": 0,
        "offset": 318
      },
      "end": {
        "line": 19,
        "column": 16,
        "offset": 418
      },
      "text": "}\n\n--- The default options.\nstrutil.defaults = { strict = false }\nstrutil.MAX = 64\n\nlocal cache = {}",
      "hash": "6c1c77e5c7da1885a64bab4f8f6371016a77705070ac4652005cb717d2929166"
    },
    {
      "id": "strutil.split#1",
      "kind": "symbol",
      "symbolId": "strutil.split",
      "start": {
        "line": 21,
        "column": 0,
        "offset": 420
      },
      "end": {
        "line": 32,
        "column": 3,
        "offset": 722
      },
      "text": "--- Splits s at sep (strutil.sep by default).\n---@param s string\n---@param sep? string\n---@return string[]\nfunction strutil.split(s, sep)\n  sep = sep or strutil.sep\n  local out = {}\n  for piece in string.gmatch(s, \"([^\" .. sep .. \"]+)\") do\n    out[#out + 1] = strutil.trim(piece)\n  end\n  return out\nend",
      "hash": "24b92f358233e3ee46bef16ef0ded775d89418ffb68d1f3bd9762df5c3fff2cd"
    },
    {
      "id": "strutil.join#1",
      "kind": "symbol",
      "symbolId": "strutil.join",
      "start": {
        "line": 34,
        "column": 0,
        "offset": 724
      },
      "end": {
        "line": 39,
        "column": 3,
        "offset": 846
      },
      "text": "--[[\n  Joins the parts with sep.\n]]\nfunction strutil.join(parts, sep)\n  return table.concat(parts, sep or strutil.sep)\nend",
      "hash": "c1f057595c16f6d519907393d31ab0ec2238e9b9ade32dc904a9da9c97fe8c28"
    },
    {
      "id": "memo#1",
      "kind": "symbol",
      "symbolId": "memo",
      "start": {
        "line": 41,
        "column": 0,
        "offset": 848
      },
      "end": {
        "line": 49,
        "column": 3,
        "offset": 1029
      },
      "text": "-- memo caches f's results by its first argument.\nlocal function memo(f)\n  return function(x)\n    if cache[x] == nil then\n      cache[x] = f(x)\n    end\n    return cache[x]\n  end\nend",
      "hash": "0305b3a839de5a463231e21f114543845912958021695557f9176bd91b55e4d8"
    },
    {
      "id": "L51#1",
      "kind": "window",
      "start": {
        "line": 51,
        "column": 0,
        "offset": 1031
      },
      "end": {
        "line": 51,
        "column": 34,
        "offset": 1065
      },
      "text": "strutil.upper = memo(string.upper)",
      "hash": "3cae15ffb10aca335cd90b34736d2e5bfaf7da2d94be04fec1f02fd1ca2146b6"
    },
    {
      "id": "strutil.startswith#1",
      "kind": "symbol",
      "symbolId": "strutil.startswith",
      "start": {
        "line": 53,
        "column": 0,
        "offset": 1067
      },
      "end": {
        "line": 56,
        "column": 3,
        "offset": 1190
      },
      "text": "--- Reports whether s starts with prefix.\nstrutil.startswith = function(s, prefix)\n  return s:sub(1, #prefix) == prefix\nend",
      "hash": "d8b577f376b2458569727fd879cc0a19232ad129474adc190a4d0e2470d95bec"
    },
    {
      "id": "count#1",
      "kind": "symbol",
      "symbolId": "count",
      "start": {
        "line": 58,
        "column": 0,
        "offset": 1192
      },
      "end": {
        "line": 60,
        "column": 3,
        "offset": 1270
      },
      "text": "local count = function(s, pattern)\n  return select(2, s:gsub(pattern, \"\"))\nend",
      "hash": "740a5ef84788e2aeeaae7ed5c496196cad560d7bdc8cf191a58d52533b545574"
    },
    {
      "id": "strutil.words#1",
      "kind": "symbol",
      "symbolId": "strutil.words",
      "start": {
        "line": 62,
        "column": 0,
        "offset": 1272
      },
      "end": {
        "line": 65,
        "column": 3,
        "offset": 1353
      },
      "text": "--- Counts the words in s.\nfunction strutil.words(s)\n  return count(s, \"%S+\")\nend",
      "hash": "dea595a05b5291a842268d1b106839132e4b8a1d8088e4b602d5492835c9a4e3"
    },
    {
      "id": "strutil_debug#1",
      "kind": "symbol",
      "symbolId": "strutil_debug",
      "start": {
        "line": 67,
        "column": 0,
        "offset": 1355
      },
      "end": {
        "line": 70,
        "column": 3,
        "offset": 1454
      },
      "text": "-- A global helper, visible to every chunk.\nfunction strutil_debug(...)\n  print(\"strutil\", ...)\nend",
      "hash": "a82b13a02e5f243fba96be76f59c556d822a1d8b0e5de36ee8e9e1021a261223"
    }
