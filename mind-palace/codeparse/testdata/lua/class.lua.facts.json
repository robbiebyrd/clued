        "line": 5,
        "column": 23,
        "offset": 145
      },
      "text": "-- Classes the usual way: a table as metatable, __index for inheritance.\n\n--- Animal is the base class.\nlocal Animal = {}\nAnimal.__index = Animal",
      "hash": "9b78cd05ca2d9166892556f1d826973393f662f3f7a74e3ef667ceb89464907b"
    },
    {
      "id": "Animal.new#1",
      "kind": "symbol",
      "symbolId": "Animal.new",
      "start": {
        "line": 7,
        "column": 0,
        "offset": 147
      },
      "end": {
        "line": 14,
        "column": 3,
        "offset": 345
      },
      "text": "--- Creates an animal called name.\nfunction Animal.new(name, sound)\n  local self = setmetatable({}, Animal)\n  self.name = name\n  self.sound = sound\n  self.on_speak = function() end\n  return self\nend",
      "hash": "3c3fc92bbdd6dfedb62ea741bf77e84752f51e588eaa81a7129c34141169fb0e"
    },
    {
      "id": "Animal.speak#1",
      "kind": "symbol",
      "symbolId": "Animal.speak",
      "start": {
        "line": 16,
        "column": 0,
        "offset": 347
      },
      "end": {
        "line": 20,
        "column": 3,
        "offset": 479
      },
      "text": "--- Speak prints the animal's sound.\nfunction Animal:speak()\n  self.on_speak()\n  print(self.name .. \" says \" .. self:sound_of())\nend",
      "hash": "f1f3dd08e104a72155464757bccf51765dae0cef620cacfefa2ffcb582fd9429"
    },
    {
      "id": "Animal.sound_of#1",
      "kind": "symbol",
      "symbolId": "Animal.sound_of",
      "start": {
        "line": 22,
        "column": 0,
        "offset": 481
      },
      "end": {
        "line": 24,
        "column": 3,
        "offset": 531
      },
      "text": "function Animal:sound_of()\n  return self.sound\nend",
      "hash": "8da235cc602023446e308142720959560f58dd34e388a88e4c6686d63c514fc9"
    },
    {
      "id": "Dog#1",
      "kind": "symbol",
      "symbolId": "Dog",
      "start": {
        "line": 26,
        "column": 0,
        "offset": 533
      },
      "end": {
        "line": 27,
        "column": 50,
        "offset": 607
      },
      "text": "--- Dog extends Animal.\nlocal Dog = setmetatable({}, { __index = Animal })",
      "hash": "c35202a65fa8cee38c8a8fb76fe016c4148c06a2da9fdcb18f85df5314f0e294"
    },
    {
      "id": "L28#1",
      "kind": "window",
      "start": {
        "line": 28,
        "column": 0,
        "offset": 608
      },
      "end": {
        "line": 28,
        "column": 17,
        "offset": 625
      },
      "text": "Dog.__index = Dog",
      "hash": "73015e484eda454536b9de993a8b7753f8228f13870fb1680b8c1fe521895854"
    },
    {
      "id": "Dog.new#1",
      "kind": "symbol",
      "symbolId": "Dog.new",
      "start": {
        "line": 30,
        "column": 0,
        "offset": 627
      },
      "end": {
        "line": 33,
        "column": 3,
        "offset": 726
      },
      "text": "function Dog.new(name)\n  local self = Animal.new(name, \"woof\")\n  return setmetatable(self, Dog)\nend",
      "hash": "01bcc0a4bd39855ca394aa812b0d2bc7b7aae593e8e0e0ffc9fb6307b4f6a108"
    },
    {
      "id": "Dog.fetch#1",
      "kind": "symbol",
      "symbolId": "Dog.fetch",
      "start": {
        "line": 35,
        "column": 0,
        "offset": 728
      },
      "end": {
        "line": 38,
        "column": 3,
        "offset": 787
      },
      "text": "function Dog:fetch(thing)\n  self:speak()\n  return thing\nend",
      "hash": "e7496c8093157e0994d58eac7274af246715a86f3e27ea1fdc264b420bf2322f"
    },
    {
      "id": "L40#1",
      "kind": "window",
      "start": {
        "line": 40,
        "column": 0,
        "offset": 789
      },
      "end": {
        "line": 41,
        "column": 39,
        "offset": 843
      },
      "text": "local Cat = {}\nsetmetatable(Cat, { __index = Animal })",
      "hash": "68bed0446d04db9890e7333e944ed9aeb65e493b233ff530fe005867e57e25dd"
    },
    {
      "id": "Cat.speak#1",
      "kind": "symbol",
