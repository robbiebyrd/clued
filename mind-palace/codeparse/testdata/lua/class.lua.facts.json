      },
      "end": {
        "line": 45,
        "column": 3,
        "offset": 890
      },
      "text": "function Cat:speak()\n  Animal.speak(self)\nend",
      "hash": "638a77def18152aedec0d2a03e2302c40b8763dffc20aea284ab6a7485355563"
    },
    {
      "id": "L47#1",
