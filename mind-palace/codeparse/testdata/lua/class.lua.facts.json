        "column": 32,
        "offset": 969
      },
      "text": "local rex = Dog.new(\"Rex\")\nrex:fetch(\"ball\")\nlocal base = require(\"lib.base\")",
      "hash": "21bedaeac0dcd1e6648bd4493dee21c7dd8c1fa9017b7b979d2717db23f2c8fa"
    },
