      "text": "#import \"Shapes.h\"\n#import \"Canvas.h\"\n\nNSString *const SKErrorDomain = @\"com.example.ShapeKit\";\ndouble ShapeKitVersionNumber = 1.0;\n\nstatic NSInteger sShapeCount = 0;",
