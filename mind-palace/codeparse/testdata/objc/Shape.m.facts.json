      "text": "id\u003cDrawable\u003e SKMakeShape(ShapeKind kind) {\n    switch (kind) {\n    case ShapeKindCircle:\n        return [Shape shapeNamed:@\"circle\"];\n    default:\n        return [[Shape alloc] initWithName:@\"polygon\" sides:5];\n    }\n}",
