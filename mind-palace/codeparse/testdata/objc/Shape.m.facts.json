      },
      "text": "// The private part of Shape.\n@interface Shape () \u003cNSSecureCoding\u003e\n@property (nonatomic, readwrite) ShapeKind kind;\n- (void)invalidate;\n@end",
      "hash": "f07323abf8e503d0020cd044d648e8471fe6a248c788a3df75ceeed5f0966355"
