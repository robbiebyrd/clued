      "text": "//\n//  Shapes.h\n//  ShapeKit\n//\n//  The public interface of ShapeKit: shapes, the drawing protocol and the\n//  C helpers they share.\n//\n\n#import \u003cFoundation/Foundation.h\u003e\n#import \u003cCoreGraphics/CoreGraphics.h\u003e\n#import \"ShapeTypes.h\"\n#include \u003cmath.h\u003e\n\n@class Canvas;\n@protocol Drawable;",
