      "text": "// Objective-C++: a C++ namespace and class next to an Objective-C class.\n// The Objective-C grammar does not know C++, so the C++ parts parse with\n// error nodes; the Objective-C parts still give their symbols.\n#import \"Bridge.h\"\n#include \u003cvector\u003e\n#include \u003cstring\u003e\n\nnamespace geometry {\n\nclass Mesh {\npublic:\n    explicit Mesh(int vertices) : vertices_(vertices) {}\n    int vertexCount() const { return vertices_; }\n\nprivate:\n    int vertices_;\n};\n\n} // namespace geometry",
      "hash": "910d860173939f09a6ab67190d625748c8bb6188d9a9d68d5f065a3918c4a0d4"
    },
    {
      "id": "MeshBridge#1",
      "kind": "symbol",
      "symbolId": "MeshBridge",
      "start": {
        "line": 21,
        "column": 0,
        "offset": 476
      },
      "end": {
        "line": 25,
        "column": 4,
        "offset": 627
      },
      "text": "/// Wraps a C++ mesh for Objective-C callers.\n@interface MeshBridge : NSObject\n- (instancetype)initWithVertices:(int)vertices;\n- (int)vertexCount;\n@end",
      "hash": "cfbeb414f8f385ac5303b4865a0ea9f13db2482cc6ae8c87592b98d18d923803"
    },
    {
      "id": "MeshBridge~2#1",
      "kind": "symbol",
      "symbolId": "MeshBridge~2",
      "start": {
        "line": 27,
        "column": 0,
        "offset": 629
      },
      "end": {
        "line": 46,
        "column": 4,
        "offset": 942
      },
      "text": "@implementation MeshBridge {\n    geometry::Mesh *_mesh;\n}\n\n- (instancetype)initWithVertices:(int)vertices {\n    if ((self = [super init])) {\n        _mesh = new geometry::Mesh(vertices);\n    }\n    return self;\n}\n\n- (int)vertexCount {\n    return _mesh-\u003evertexCount();\n}\n\n- (void)dealloc {\n    delete _mesh;\n}\n\n@end",
      "hash": "21bff487174c4740ab15daff68b1a1383ca14e80c67f01f574615af720ebe983"
    },
