      },
      "end": {
        "line": 104,
        "column": 1,
        "offset": 2210
      },
      "text": "impl\u003cV: Storable\u003e fmt::Display for Store\u003cV\u003e {\n    fn fmt(\u0026self, f: \u0026mut fmt::Formatter\u003c'_\u003e) -\u003e fmt::Result {\n        write!(f, \"{} entries\", self.entries.len())\n    }\n}",
      "hash": "d5e6248105c947c5ce2aa25df44ce32c445ecacdafcb78a33e5b1726b352fe43"
    },
