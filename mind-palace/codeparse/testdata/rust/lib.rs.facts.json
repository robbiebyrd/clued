      },
      "end": {
        "line": 33,
        "column": 1,
        "offset": 728
      },
      "text": "pub struct Entry\u003cV\u003e {\n    /// The stored value.\n    pub value: V,\n    #[serde(default)]\n    pub(crate) version: u64,\n    created: Instant,\n}",
      "hash": "f3ba62c82632b3715b7ce23acfa84527735841aa1b0f98c95d746f4e516df1c5"
