      },
      "text": "//! A small key-value store: the crate root of the golden inputs.\n\npub mod error;\nmod storage;\npub(crate) mod util {",
      "hash": "b5aa9b738a8899c2f8c9473aaadc030ced41ff74b4eb4d324741db59f83d52a0"
