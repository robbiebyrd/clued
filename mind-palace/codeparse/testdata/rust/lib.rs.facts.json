        "column": 0,
        "offset": 117
      },
      "end": {
        "line": 9,
        "column": 5,
        "offset": 235
      },
      "text": "    /// Clamps a capacity to the allowed range.\n    pub fn clamp(n: usize) -\u003e usize {\n        n.min(MAX_ENTRIES)\n    }",
      "hash": "5781b60dcfb512db432b0154a4d10d257b9a2b02077e1ca440a55265d87ab7ec"
