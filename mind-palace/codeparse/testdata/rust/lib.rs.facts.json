      },
      "end": {
        "line": 49,
        "column": 1,
        "offset": 1036
      },
      "text": "pub enum Lookup\u003cV\u003e {\n    /// The key holds a value.\n    Found(V),\n    /// The key was removed at this version.\n    Removed { at: u64, by: Key },\n    Missing,\n}",
      "hash": "a700f045c480e1b6fb46c6545c9c4d4468b5b708f490657ed4515bf98e7b673e"
    },
    {
