        "offset": 1496
      },
      "end": {
        "line": 76,
        "column": 18,
        "offset": 1529
      },
      "text": "/// The store.\n#[derive(Default)]",
      "hash": "4316adb5b20d1d082cd60c3dbaae8a3f7c2e7b9db5deaacc15864286dd6e36b8"
    },
