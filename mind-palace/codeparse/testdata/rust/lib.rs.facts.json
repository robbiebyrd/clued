      },
      "text": "macro_rules! store {\n    ($($k:expr =\u003e $v:expr),* $(,)?) =\u003e {{\n        let mut s = $crate::Store::new();\n        $( s.insert($k, $v); )*\n        s\n    }};\n}",
      "hash": "23340be2e74ec8f62afb41723ef16a1a54567aa9ab4d9e132127dce675850adf"
