      },
      "end": {
        "line": 22,
        "column": 22,
        "offset": 492
      },
      "text": "/// A key in the store.\npub type Key = String;",
      "hash": "a7d13a8c67b2d7a21ca732e0bd081d4962cbc2fd955216a3c787ca03f264e8fa"
