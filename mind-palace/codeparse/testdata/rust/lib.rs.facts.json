        "offset": 1530
      },
      "end": {
        "line": 79,
        "column": 1,
        "offset": 1600
      },
      "text": "pub struct Store\u003cV: Storable\u003e {\n    entries: HashMap\u003cKey, Entry\u003cV\u003e\u003e,\n}",
      "hash": "eb44a4f6973204de1999648e41d7ca8138bc683a68211fd275c7298943d90e00"
    },
    {
      "id": "Store~2#1",
      "kind": "symbol",
      "symbolId": "Store~2",
      "start": {
        "line": 81,
        "column": 0,
        "offset": 1602
      },
      "end": {
        "line": 98,
        "column": 1,
        "offset": 2040
      },
      "text": "impl\u003cV: Storable\u003e Store\u003cV\u003e {\n    /// Opens an empty store.\n    #[must_use]\n    pub fn new() -\u003e Self {\n        OPENED.fetch_add(1, Ordering::SeqCst);\n        Store { entries: HashMap::new() }\n    }\n\n    /// Looks a key up.\n    pub fn get(\u0026self, key: \u0026str) -\u003e Lookup\u003c\u0026V\u003e {\n        match self.entries.get(key) {\n            Some(e) =\u003e Lookup::Found(\u0026e.value),\n            None =\u003e Lookup::Missing,\n        }\n    }\n\n    fn bump(\u0026mut self) {}\n}",
      "hash": "3bb10348217ddbbb5c9a34302c03403a49e14e33e983c64ea8f683a339180fda"
    },
