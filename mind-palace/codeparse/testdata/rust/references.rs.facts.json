      },
      "text": "use std::fmt;\n\nuse crate::shapes::{Circle, Shape};",
      "hash": "35fc13aec0468d36409eb9df36aaa0db91dbd592d682ce09bd4d3da6fac9f5bf"
    },
    {
      "id": "Draw#1",
      "kind": "symbol",
      "symbolId": "Draw",
      "start": {
        "line": 5,
        "column": 0,
        "offset": 52
      },
      "end": {
        "line": 8,
        "column": 1,
        "offset": 163
      },
      "text": "/// Draws shapes onto a canvas.\npub trait Draw: fmt::Debug + Shape {\n    fn draw(\u0026self, canvas: \u0026mut Canvas);\n}",
      "hash": "1a4a04edcbb6e2b034663d3685e67e06e9a340d223cf5de22cb83c0e08d8ed2b"
    },
    {
      "id": "Canvas#1",
      "kind": "symbol",
      "symbolId": "Canvas",
      "start": {
        "line": 10,
        "column": 0,
        "offset": 165
      },
      "end": {
        "line": 14,
        "column": 1,
        "offset": 260
      },
      "text": "/// A canvas of pixels.\npub struct Canvas {\n    pixels: Vec\u003cPixel\u003e,\n    size: geometry::Size,\n}",
      "hash": "7c46b454ef774f051acfffea697d3aeffc26016948db78ff1b1dc169b43a41f5"
    },
    {
      "id": "Circle#1",
      "kind": "symbol",
      "symbolId": "Circle",
      "start": {
        "line": 16,
        "column": 0,
        "offset": 262
      },
      "end": {
        "line": 26,
        "column": 1,
        "offset": 603
      },
      "text": "impl Draw for Circle {\n    fn draw(\u0026self, canvas: \u0026mut Canvas) {\n        let center = self.center();\n        canvas.plot(center, Color::RED);\n        render::\u003cCircle\u003e(self, canvas);\n        geometry::arc(center, self.radius);\n        trace!(\"drew {:?}\", self);\n        log::debug!(\"circle at {:?}\", center);\n        println!(\"done\");\n    }\n}",
      "hash": "6c25a008d30794be4612bbf51c4d44f9e97f1091a2e34e1ac0557d45ddb2a8b6"
    },
    {
      "id": "Canvas~2#1",
      "kind": "symbol",
      "symbolId": "Canvas~2",
      "start": {
        "line": 28,
        "column": 0,
        "offset": 605
      },
      "end": {
        "line": 34,
        "column": 1,
        "offset": 783
      },
      "text": "impl\u003cT: Shape\u003e From\u003cT\u003e for Canvas {\n    fn from(shape: T) -\u003e Self {\n        let mut c = Canvas::with_size(shape.bounds());\n        c.fill(shape.color().into());\n        c\n    }\n}",
      "hash": "c2f0b1beccbdecfbedbe582a76dd6426a3be374275a7d31748822dfc4426e3e0"
    },
    {
      "id": "Canvas~3#1",
      "kind": "symbol",
      "symbolId": "Canvas~3",
      "start": {
        "line": 36,
        "column": 0,
        "offset": 785
      },
      "end": {
        "line": 41,
        "column": 1,
        "offset": 977
      },
      "text": "impl fmt::Display for Canvas {\n    fn fmt(\u0026self, f: \u0026mut fmt::Formatter\u003c'_\u003e) -\u003e fmt::Result {\n        let n = self.pixels.iter().filter(|p| p.lit()).count();\n        write!(f, \"{}\", n)\n    }\n}",
      "hash": "7165e0f50cd95005212b6f98d466a3aa76cfc2b12f5ba33a651740d78bfcf903"
    },
    {
      "id": "render#1",
      "kind": "symbol",
      "symbolId": "render",
      "start": {
        "line": 43,
        "column": 0,
        "offset": 979
      },
      "end": {
        "line": 48,
        "column": 1,
        "offset": 1177
      },
      "text": "/// Renders any shape.\npub fn render\u003cS: Shape + ?Sized\u003e(shape: \u0026S, canvas: \u0026mut Canvas) -\u003e Option\u003cPixel\u003e {\n    let first = canvas.pixels.first().copied();\n    shape.paint(canvas);\n    Some(first?)\n}",
      "hash": "025c9875245affd40e41bd2d1ffa860f5ba115d6c4bb946f2f0fe1b5368da7df"
    }
  ]
}
