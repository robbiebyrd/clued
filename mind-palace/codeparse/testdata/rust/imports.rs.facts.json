      "text": "// Every form of `use`, `extern crate` and `mod` declarations.\nextern crate alloc;\nextern crate serde_json as json;\n\nmod parser;\n#[cfg(test)]\nmod tests;\npub mod api;\n\nuse std::io;\nuse std::collections::HashMap;\nuse std::sync::{Arc, Mutex, mpsc::Sender as Tx};\nuse std::fmt::{self, Display};\nuse crate::config::Config as Settings;\nuse super::*;\nuse self::parser::{ast::{Expr, Stmt}, lexer::*};\npub use api::Client;\nuse ::serde::Deserialize;\nuse tokio;\nuse log as logging;",
      "hash": "66597301948ca36bdcdb7300560c395de9b251577c051b453b5e4d775b98fc04"
    },
