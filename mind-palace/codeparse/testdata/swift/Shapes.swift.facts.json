      "end": {
        "line": 1,
        "column": 17,
        "offset": 17
      },
      "text": "import Foundation",
      "hash": "55aac2c2aa641984035e30775100e49413795cb00816ca20cebbecec6f805d78"
    },
    {
      "id": "Shape#1",
      "kind": "symbol",
      "symbolId": "Shape",
      "start": {
        "line": 3,
        "column": 0,
        "offset": 19
      },
      "end": {
        "line": 17,
        "column": 1,
        "offset": 484
      },
      "text": "/// Something that can be drawn and measured.\npublic protocol Shape: AnyObject, CustomStringConvertible {\n    /// The unit areas are measured in.\n    associatedtype Unit\n    typealias Measure = (Double, Unit)\n\n    /// The area, in square units.\n    var area: Double { get }\n    var name: String { get set }\n\n    /// Draws the shape into a context.\n    func draw(in context: DrawingContext) -\u003e Bool\n    init(name: String)\n    subscript(index: Int) -\u003e Point { get }\n}",
      "hash": "c9d5d70022dc0b033f023a52610875eada424e560c7bf0b458f0174618fb4dc5"
    },
    {
      "id": "Point#1",
      "kind": "symbol",
      "symbolId": "Point",
      "start": {
        "line": 19,
        "column": 0,
        "offset": 486
      },
      "end": {
        "line": 40,
        "column": 1,
        "offset": 1014
      },
      "text": "/// A point on the plane.\npublic struct Point: Hashable, Codable {\n    public let x: Double\n    public var y: Double = 0\n    static let origin = Point(x: 0, y: 0)\n    private var label: String?, tag = 0\n\n    public init(x: Double, y: Double) {\n        self.x = x\n        self.y = y\n    }\n\n    /// Moves the point in place.\n    public mutating func move(by dx: Double, _ dy: Double) {\n        y += dy\n    }\n\n    func distance(to other: Point) -\u003e Double {\n        let dx = other.x - x\n        return (dx * dx).squareRoot()\n    }\n}",
      "hash": "876bb81da8e1dec710191ac4a5be56df5c3e3ea6225f2df00d4d9f97c430bbd2"
    },
    {
      "id": "Circle#1",
      "kind": "symbol",
      "symbolId": "Circle",
      "start": {
        "line": 42,
        "column": 0,
        "offset": 1016
      },
      "end": {
        "line": 69,
        "column": 1,
        "offset": 1686
      },
      "text": "/// A circle around a centre.\nopen class Circle: Figure, Shape {\n    public typealias Unit = Double\n\n    private var radius: Double\n    public var name: String\n    public var area: Double { .pi * radius * radius }\n\n    public required init(name: String) {\n        self.name = name\n        self.radius = 1\n    }\n\n    deinit {\n        Registry.shared.forget(self)\n    }\n\n    public subscript(index: Int) -\u003e Point {\n        Point(x: radius, y: Double(index))\n    }\n\n    open override func draw(in context: DrawingContext) -\u003e Bool {\n        context.stroke(circleAt: .zero, radius: radius)\n        return true\n    }\n\n    class func unit() -\u003e Circle { Circle(name: \"unit\") }\n}",
      "hash": "6696b8198ff60aac08ec9d1525a84bf8953b3f026c24ff9b679facdf6969af5e"
    },
    {
      "id": "Direction#1",
      "kind": "symbol",
      "symbolId": "Direction",
      "start": {
        "line": 71,
        "column": 0,
        "offset": 1688
      },
      "end": {
        "line": 87,
        "column": 1,
        "offset": 2058
      },
      "text": "/// Compass directions.\nenum Direction: String, CaseIterable {\n    case north, south\n    case east = \"E\"\n    case west\n\n    var opposite: Direction {\n        switch self {\n        case .north: return .south\n        case .south: return .north\n        case .east: return .west\n        case .west: return .east\n        }\n    }\n\n    func turned() -\u003e Direction { opposite }\n}",
      "hash": "063557023a41717d0fb84192f4d197a7fe1f2f07bff7c1339936d7cbcd69d191"
    },
    {
      "id": "Tree#1",
      "kind": "symbol",
      "symbolId": "Tree",
      "start": {
        "line": 89,
        "column": 0,
        "offset": 2060
      },
      "end": {
        "line": 93,
        "column": 1,
        "offset": 2173
      },
      "text": "/// A result that carries a payload.\nindirect enum Tree\u003cValue\u003e {\n    case leaf(Value)\n    case node(Tree, Tree)\n}",
      "hash": "b1df890049a3287ecd52eb93becd2f431534f340f30c9d00f3599350544fb713"
    },
    {
      "id": "Counter#1",
      "kind": "symbol",
      "symbolId": "Counter",
      "start": {
        "line": 95,
        "column": 0,
        "offset": 2175
      },
      "end": {
        "line": 103,
        "column": 1,
        "offset": 2325
      },
      "text": "/// Counts in isolation.\nactor Counter {\n    private(set) var value = 0\n\n    func increment() -\u003e Int {\n        value += 1\n        return value\n    }\n}",
      "hash": "8a16c1291fbf691954b8f6f0545f5d8387eb024bc2b17b02b0babee07256cd30"
    },
    {
      "id": "Point~2#1",
      "kind": "symbol",
      "symbolId": "Point~2",
      "start": {
        "line": 105,
        "column": 0,
        "offset": 2327
      },
      "end": {
        "line": 111,
        "column": 1,
        "offset": 2536
      },
      "text": "extension Point: CustomStringConvertible {\n    public var description: String { \"(\\(x), \\(y))\" }\n\n    static func + (lhs: Point, rhs: Point) -\u003e Point {\n        Point(x: lhs.x + rhs.x, y: lhs.y + rhs.y)\n    }\n}",
      "hash": "61e6a3643b3906ab6b444019c20d64b4945c007347b8980a4a1c3a5317948448"
    },
    {
      "id": "L113#1",
      "kind": "window",
      "start": {
        "line": 113,
        "column": 0,
        "offset": 2538
      },
      "end": {
        "line": 115,
        "column": 17,
        "offset": 2616
      },
      "text": "/// The default drawing scale.\npublic let defaultScale = 2.0\nvar drawCount = 0",
      "hash": "3581158e0d73def6cb911c2b8c6ab2421c71a5d934e07cfd3d807c177bcb8748"
    },
    {
      "id": "Completion#1",
