      },
      "end": {
        "line": 116,
        "column": 58,
        "offset": 2675
      },
      "text": "public typealias Completion = (Result\u003cInt, Error\u003e) -\u003e Void",
      "hash": "89ec782da762b306b2728fea536300b78c1b76c2e4f9443e963f7fdcd8ab03d6"
    },
    {
      "id": "drawAll#1",
      "kind": "symbol",
      "symbolId": "drawAll",
      "start": {
        "line": 118,
        "column": 0,
        "offset": 2677
      },
      "end": {
        "line": 121,
        "column": 1,
        "offset": 2857
      },
      "text": "/// Draws every shape and counts the successes.\npublic func drawAll\u003cS: Shape\u003e(_ shapes: [S], in context: DrawingContext) -\u003e Int {\n    shapes.filter { $0.draw(in: context) }.count\n}",
      "hash": "187b1523cbeb556b171c0e813e96a84c5e3e8b08adb95651034d3c218114b77e"
    },
