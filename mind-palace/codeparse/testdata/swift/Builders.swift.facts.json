      },
      "text": "public extension Array where Element == Canvas.Layer {\n    func topmost() -\u003e Element? { last }\n}",
      "hash": "e85b0d56a8d654747d6e55930fe05a4f1cf48015f24a98e36241d1a96c4c9a11"
