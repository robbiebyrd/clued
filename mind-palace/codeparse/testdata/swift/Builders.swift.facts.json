      "text": "/// Nested definitions, result builders, property wrappers and macros.\npublic struct Canvas: View {\n    public struct Layer: Identifiable {\n        public enum Blend: Int { case normal, multiply }\n\n        public let id: Int\n        var blend: Blend = .normal\n\n        struct Cache {\n            static var hits = 0\n\n            /**\n             Forgets every hit.\n             */\n            func reset() { Cache.hits = 0 }\n        }\n    }\n\n    @State private var layers: [Layer] = []\n    public private(set) var revision = 0\n    @Environment(\\.colorScheme) var scheme\n\n    public var body: some View {\n        VStack {\n            ForEach(layers) { layer in\n                Text(\"\\(layer.id)\")\n            }\n            Button(\"Add\") { addLayer() }\n        }\n        .padding()\n    }\n\n    private func addLayer() {\n        func nextID() -\u003e Int { layers.count + 1 }\n        let (value, code) = #stringify(nextID())\n        layers.append(Layer(id: value))\n        print(code)\n    }\n}",
      "hash": "21faad7c5144779a87c73789913920a3f7b01d11827e90cecc665c5e22de618a"
    },
