        "offset": 1108
      },
      "text": "extension Canvas.Layer: Equatable {\n    public static func == (a: Self, b: Self) -\u003e Bool { a.id == b.id }\n}",
      "hash": "8b143b34a681938759bd8c775a527ff96b60ba87ad60fceb2629b33f1068537c"
    },
