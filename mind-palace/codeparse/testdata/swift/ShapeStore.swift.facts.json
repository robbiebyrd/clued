        "line": 9,
        "column": 1,
        "offset": 159
      },
      "text": "/// Errors the store reports.\nenum StoreError: Error {\n    case notFound(id: UUID)\n    case invalid(String)\n}",
      "hash": "97047c40c2d8b29ea09389b56a06ea523e8361e037fc3358032fd7797d8c4921"
    },
    {
      "id": "ShapeRepository#1",
      "kind": "symbol",
      "symbolId": "ShapeRepository",
      "start": {
        "line": 11,
        "column": 0,
        "offset": 161
      },
      "end": {
        "line": 14,
        "column": 1,
        "offset": 280
      },
      "text": "protocol ShapeRepository {\n    func load(id: UUID) async throws -\u003e Circle\n    func save(_ shape: Circle) async throws\n}",
      "hash": "78fd2510be025b2f1c9deefdd6b720960ccfbabb32c6f92613b4e5af7c31bc5d"
    },
    {
      "id": "ShapeStore#1",
      "kind": "symbol",
      "symbolId": "ShapeStore",
      "start": {
        "line": 16,
        "column": 0,
        "offset": 282
      },
      "end": {
        "line": 57,
        "column": 1,
        "offset": 1595
      },
      "text": "/// Loads and caches shapes for the editor.\n@MainActor\nfinal class ShapeStore: ObservableObject, ShapeRepository {\n    @Published private(set) var shapes: [UUID: Circle] = [:]\n    private let backend: Backend\n    private var cancellables = Set\u003cAnyCancellable\u003e()\n\n    init(backend: Backend = .live) {\n        self.backend = backend\n        backend.changes\n            .receive(on: DispatchQueue.main)\n            .sink { [weak self] change in self?.apply(change) }\n            .store(in: \u0026cancellables)\n    }\n\n    func load(id: UUID) async throws -\u003e Circle {\n        if let cached = shapes[id] {\n            return cached\n        }\n        guard let data = try await backend.fetch(id) else {\n            throw StoreError.notFound(id: id)\n        }\n        let circle = try JSONDecoder().decode(Circle.self, from: data)\n        shapes[id] = circle\n        return circle\n    }\n\n    func save(_ shape: Circle) async throws {\n        let data = try JSONEncoder().encode(shape)\n        try await backend.put(data, for: shape.id)\n        notify(ShapeEvent.saved(shape.id))\n    }\n\n    private func apply(_ change: Backend.Change) {\n        switch change {\n        case .removed(let id):\n            shapes.removeValue(forKey: id)\n        case .updated(let circle):\n            shapes[circle.id] = circle\n        }\n    }\n}",
      "hash": "114803dc9e9631fcfe7ab3e341387b82e44e072cb0299c9952505077544603cc"
    },
    {
      "id": "CachingStore#1",
      "kind": "symbol",
      "symbolId": "CachingStore",
      "start": {
        "line": 59,
        "column": 0,
        "offset": 1597
      },
      "end": {
        "line": 63,
        "column": 1,
        "offset": 1779
      },
      "text": "final class CachingStore\u003cKey: Hashable, Value\u003e: Cache\u003cKey, Value\u003e, Sendable {\n    override func value(for key: Key) -\u003e Value? {\n        super.value(for: key) ?? fallback(key)\n    }\n}",
      "hash": "c31b115b285c3b71e594eee04c01db7c590b7971e2d62ed451d4b43dc5d4723d"
    },
    {
      "id": "notify#1",
      "kind": "symbol",
      "symbolId": "notify",
      "start": {
        "line": 65,
        "column": 0,
        "offset": 1781
      },
      "end": {
        "line": 68,
        "column": 1,
        "offset": 1919
      },
      "text": "func notify(_ event: ShapeEvent) {\n    NotificationCenter.default.post(name: .shapeEvent, object: event)\n    Analytics.track(event.name)\n}",
      "hash": "5280eb94b9213a85f014a3238ddfd8f85b645a86d043fea1edc72fb7bcb0082e"
    }
