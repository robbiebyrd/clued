        "line": 8,
        "column": 3,
        "offset": 214
      },
      "text": "# Compact and nested namespaces, reopened classes and definitions written\n# as calls: the cases name-based resolution has to get right.\n\nautoload :Ledger, \"billing/ledger\"\n\nmodule Billing\n  module Gateways; end\nend",
      "hash": "b9369913e5e481e4ec8344512272fe363b3043089154afad8353bd154f1c1b7d"
    },
    {
      "id": "Billing::Gateways::Stripe#1",
      "kind": "symbol",
      "symbolId": "Billing::Gateways::Stripe",
      "start": {
        "line": 10,
        "column": 0,
        "offset": 216
      },
      "end": {
        "line": 19,
        "column": 3,
        "offset": 476
      },
      "text": "=begin\nStripe is reached through Billing::Gateways, written compactly.\n=end\nclass Billing::Gateways::Stripe \u003c Billing::Gateways::Base\n  API_VERSION = \"2024-06-20\"\n\n  def charge(amount, token)\n    client.post(\"/charges\", amount: amount, source: token)\n  end\nend",
      "hash": "a573a384de969acd6b828186f5cfa60fca6e147886439f23159595102582e79a"
    },
    {
      "id": "Billing::Invoice#1",
      "kind": "symbol",
      "symbolId": "Billing::Invoice",
      "start": {
        "line": 22,
        "column": 0,
        "offset": 493
      },
      "end": {
        "line": 50,
        "column": 5,
        "offset": 1222
      },
      "text": "  # Reopens the module: Invoice is nested lexically.\n  class Invoice\n    Line = Struct.new(:description, :cents)\n    Totals = Data.define(:net, :tax)\n    Formatting = Module.new\n\n    %w[draft sent paid].each do |state|\n      define_method(:\"#{state}?\") { @state == state }\n    end\n\n    define_method(:void!) do\n      @state = \"void\"\n    end\n\n    alias_method :to_s, :number\n    alias settle pay\n\n    def self.[](number) = new(number)\n\n    def pay\n      Gateways::Stripe.new.charge(total, token)\n    end\n\n    def ==(other) = other.is_a?(Invoice) \u0026\u0026 number == other.number\n\n    # A compact name inside a nesting: Monthly is qualified by its lexical\n    # containers, Reports stays a reference.\n    class Reports::Monthly; end\n  end",
      "hash": "ab5d04b3189d9359104b62831a1e2bbfd8acb842161c75b82d0b0a67c4004d33"
    },
    {
      "id": "L52#1",
      "kind": "window",
      "start": {
        "line": 52,
        "column": 0,
        "offset": 1224
      },
      "end": {
        "line": 53,
        "column": 3,
        "offset": 1252
      },
      "text": "  Gateways::TIMEOUT = 15\nend",
      "hash": "3d9d74c76c7c95528f67c1e82d733809aee743fe3f0557338647420914a43863"
    },
    {
      "id": "Refund#1",
      "kind": "symbol",
      "symbolId": "Refund",
      "start": {
        "line": 55,
