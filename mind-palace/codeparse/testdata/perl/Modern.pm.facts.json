      },
      "text": "=head2 Zoo::Point\n\nA point, written with the 5.38 class syntax.\n\n=cut\n\nclass Zoo::Point 1.0 :isa(Zoo::Shape) {\n    field $x :param = 0;\n    field @history;\n\n    method norm {\n        return sqrt($x * $x);\n    }\n\n    method move ($dx) { $x += $dx; push @history, $dx; return $self }\n}",
      "hash": "b37db555c7b7939d5d87ac6a76b2eced5fdc2720bb6820ae7b73fbf4c6808127"
    }
