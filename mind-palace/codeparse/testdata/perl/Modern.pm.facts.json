      "text": "use v5.38;\nuse experimental 'class';\n\npackage Zoo::Animal {\n    use Moose;\n    extends 'Zoo::Base';\n    with 'Zoo::Role::Walks', 'Zoo::Role::Eats';\n\n    has 'name' =\u003e (is =\u003e 'ro', isa =\u003e 'Str');\n    has legs =\u003e (is =\u003e 'rw', default =\u003e 4);",
