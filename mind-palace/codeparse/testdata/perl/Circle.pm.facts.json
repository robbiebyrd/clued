      },
      "text": "package My::Shape::Circle;\n\n# A circle with a radius; the classic one-package-per-file module.\n\nuse strict;\nuse warnings;\nuse parent -norequire, 'My::Shape';\nuse base qw(Exporter);\nuse POSIX qw(floor);\nuse Scalar::Util 'blessed';\nuse List::Util ();\nuse constant PI =\u003e 3.14159;\nuse constant { E =\u003e 2.718, ZERO =\u003e 0 };\nrequire Carp;\nrequire \"shapes/config.pl\";\n\nour @ISA = ('My::Base');\nour $VERSION = '1.02';\nour @EXPORT_OK = qw(area);\nour ($_registry, %cache);\nmy $count = 0;",
      "hash": "c0cea5295f3ec19fd402cdd1eafdf564f82f66df0ab342e9367ef9e6661c99b1"
    },
    {
      "id": "My::Shape::Circle::new#1",
      "kind": "symbol",
      "symbolId": "My::Shape::Circle::new",
      "start": {
        "line": 23,
        "column": 0,
        "offset": 477
      },
      "end": {
        "line": 30,
        "column": 1,
        "offset": 639
      },
      "text": "# Creates a new circle.\n# Takes a radius.\nsub new {\n    my ($class, %args) = @_;\n    my $self = bless { r =\u003e $args{r} }, $class;\n    $count++;\n    return $self;\n}",
      "hash": "fff819bde3c75cf95b419897a807fdc80469ed77c2ae9f161dba126d7790956c"
    },
    {
      "id": "My::Shape::Circle::area#1",
      "kind": "symbol",
      "symbolId": "My::Shape::Circle::area",
      "start": {
        "line": 32,
        "column": 0,
        "offset": 641
      },
      "end": {
        "line": 41,
        "column": 1,
        "offset": 754
      },
      "text": "=head2 area\n\nReturns the area.\n\n=cut\n\nsub area :lvalue {\n    my $self = shift;\n    return PI * $self-\u003e{r} ** 2;\n}",
      "hash": "39de7e63f2b2e005de9fd37d2f867874cc8bfeaeab3f7464f29666a058477eea"
    },
    {
      "id": "My::Shape::Circle::_scale#1",
      "kind": "symbol",
      "symbolId": "My::Shape::Circle::_scale",
      "start": {
        "line": 43,
        "column": 0,
        "offset": 756
      },
      "end": {
        "line": 43,
        "column": 39,
        "offset": 795
      },
      "text": "sub _scale($$) { return $_[0] * $_[1] }",
      "hash": "d6eb382d8cc759678b47d33976f492d1428a41447cbe8f08b7aab143461cef28"
    },
    {
      "id": "My::Shape::Circle::My::Shape::Registry::register#1",
      "kind": "symbol",
      "symbolId": "My::Shape::Circle::My::Shape::Registry::register",
      "start": {
        "line": 45,
        "column": 0,
        "offset": 797
      },
      "end": {
        "line": 46,
        "column": 74,
        "offset": 913
      },
      "text": "# Defined into another package from here.\nsub My::Shape::Registry::register { Carp::croak(\"no registry\") unless @_ }",
      "hash": "4061308676e99f0a70b97894ae8b716ff76063ac6ac93e9fc3ba7921b81f9dcc"
    },
    {
      "id": "My::Shape::Circle::describe#1",
      "kind": "symbol",
      "symbolId": "My::Shape::Circle::describe",
      "start": {
        "line": 48,
        "column": 0,
        "offset": 915
      },
      "end": {
        "line": 54,
        "column": 1,
        "offset": 1094
      },
      "text": "sub describe {\n    my $self = shift;\n    our $calls;\n    my $area = $self-\u003earea();\n    printf(\"%s\\n\", floor($area));\n    return blessed($self) . ': ' . $self-\u003eSUPER::describe();\n}",
      "hash": "47a5819c9f0720d94b11dbc07df78e306df25a9d8e5c95f0f240f019b616e8d5"
    },
