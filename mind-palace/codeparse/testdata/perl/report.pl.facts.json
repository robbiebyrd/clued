      "text": "#!/usr/bin/env perl\n# Prints a report of every shape: a script with no package.\nuse strict;\nuse warnings;\nuse lib 'lib';\nuse Getopt::Long qw(GetOptions);\nuse My::Shape::Circle;\nuse Text::Wrap 'wrap', \"fill\";\nrequire My::Report;\n\nmy %opt;\nGetOptions(\\%opt, 'verbose');",
      "hash": "5693740b25e09a1d3763ff8cd44cd977218382005e772c3519e3ee827e434601"
    },
    {
      "id": "main#1",
      "kind": "symbol",
      "symbolId": "main",
      "start": {
        "line": 14,
        "column": 0,
        "offset": 269
      },
      "end": {
        "line": 26,
        "column": 1,
        "offset": 631
      },
      "text": "sub main {\n    my @shapes = load_shapes(@ARGV);\n    for my $shape (@shapes) {\n        report($shape);\n        \u0026log_line(\"shape\", $shape);\n        My::Report::emit($shape-\u003earea, ref $shape);\n        \u0026My::Report::flush();\n    }\n    my $c = My::Shape::Circle-\u003enew(r =\u003e 1);\n    my $printer = My::Report-\u003ecan('printer');\n    $c-\u003edescribe;\n    return scalar @shapes;\n}",
      "hash": "f2829d6e4fbd9c8a141bcb4e6429d154bc2b815852277a411406058c2e43035a"
    },
    {
      "id": "load_shapes#1",
      "kind": "symbol",
      "symbolId": "load_shapes",
      "start": {
        "line": 28,
        "column": 0,
        "offset": 633
      },
      "end": {
        "line": 28,
        "column": 69,
        "offset": 702
      },
      "text": "sub load_shapes { return map { My::Shape::Circle-\u003enew(r =\u003e $_) } @_ }",
      "hash": "f9a6a67cc18c1e02f15e527dd1f57e5457fcccdfa08b6632d2617e84d16f8e79"
    },
    {
      "id": "report#1",
      "kind": "symbol",
      "symbolId": "report",
      "start": {
        "line": 30,
        "column": 0,
        "offset": 704
      },
      "end": {
        "line": 30,
        "column": 41,
        "offset": 745
      },
      "text": "sub report { print join(\", \", @_), \"\\n\" }",
      "hash": "aafecf8fe5ec395d9a0c0ac8ac7af49b69a635f211d3fbf76466ae0f99ec4836"
    },
