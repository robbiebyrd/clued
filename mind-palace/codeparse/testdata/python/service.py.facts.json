        "line": 15,
        "column": 50,
        "offset": 302
      },
      "text": "class ServiceError(Exception):\n    \"\"\"Raised when a call to the service fails.\"\"\"",
      "hash": "90012d0ed82f26085aae8cea654e37bc81a84da70dcab4733f5a9edc074365b2"
    },
    {
      "id": "Repository#1",
      "kind": "symbol",
      "symbolId": "Repository",
      "start": {
        "line": 18,
        "column": 0,
        "offset": 305
      },
      "end": {
        "line": 23,
        "column": 50,
        "offset": 479
      },
      "text": "class Repository(ABC, Generic[T]):\n    @abstractmethod\n    def get(self, key: str) -\u003e Optional[T]: ...\n\n    @abstractmethod\n    def put(self, key: str, value: T) -\u003e None: ...",
      "hash": "a8b820b5ec82f3df49d0ab496966dd1031edc1529e5b6da4431de4307f6f070d"
    },
    {
      "id": "ItemRepository#1",
      "kind": "symbol",
      "symbolId": "ItemRepository",
      "start": {
        "line": 26,
        "column": 0,
        "offset": 482
      },
      "end": {
        "line": 45,
        "column": 64,
        "offset": 1301
      },
      "text": "class ItemRepository(Repository[Item], store.Base, metaclass=store.Registry):\n    def __init__(self, session: requests.Session, base_url: str) -\u003e None:\n        super().__init__()\n        self.session = session\n        self.base_url = base_url\n\n    def get(self, key: str) -\u003e Optional[Item]:\n        try:\n            resp = self.session.get(f\"{self.base_url}/{key}\")\n            resp.raise_for_status()\n        except (requests.HTTPError, ConnectionError) as exc:\n            log.warning(\"get %s: %s\", key, exc)\n            raise ServiceError(key) from exc\n        except store.NotFound:\n            return None\n        return Item.parse(resp.text)\n\n    def put(self, key: str, value: Item) -\u003e None:\n        payload: dict[str, store.Value] = encode(value)\n        self.session.put(f\"{self.base_url}/{key}\", json=payload)",
      "hash": "f7c999e75f8958baacd42d6c51d62a742e63154ff9559bdeac9436bd16ba9d31"
    },
    {
      "id": "encode#1",
      "kind": "symbol",
      "symbolId": "encode",
      "start": {
        "line": 48,
        "column": 0,
        "offset": 1304
      },
      "end": {
        "line": 49,
        "column": 66,
        "offset": 1423
      },
      "text": "def encode(item: Sized) -\u003e dict[str, \"store.Value\"]:\n    return {\"size\": item.size(), \"checksum\": store.checksum(item)}",
      "hash": "3dd3a0942de81fba32979389a70c9e70ba36923d9b2af1961e347448fd9f3a8e"
    },
    {
      "id": "L52#1",
      "kind": "window",
      "start": {
        "line": 52,
        "column": 0,
        "offset": 1426
      },
      "end": {
        "line": 53,
        "column": 15,
        "offset": 1452
      },
      "text": "@log.catch\n@retry(times=3)",
      "hash": "4ce6619ad0da380cc4c2723a4cb0641be19068f82e75ef936561551dda74b2f2"
    },
    {
      "id": "sync#1",
      "kind": "symbol",
      "symbolId": "sync",
      "start": {
        "line": 54,
        "column": 0,
        "offset": 1453
      },
      "end": {
        "line": 60,
        "column": 16,
        "offset": 1639
      },
      "text": "def sync(repo: ItemRepository, items: list[Item]) -\u003e int:\n    count = 0\n    for item in items:\n        repo.put(item.name, item)\n        count += 1\n    print(len(items))\n    return count",
      "hash": "eeac23d0c9e48cb2a8edc59c22adedf645a295754c9d6b656bbe872c13e51740"
    }
