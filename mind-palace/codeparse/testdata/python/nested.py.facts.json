      "text": "def memoize(fn):\n    \"\"\"Caches fn's results.\"\"\"\n    cache = {}\n\n    @functools.wraps(fn)\n    def wrapper(*args):\n        if args not in cache:\n            cache[args] = fn(*args)\n        return cache[args]\n\n    return wrapper",
