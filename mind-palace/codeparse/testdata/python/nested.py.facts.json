      },
      "text": "def make_counter(start=0):\n    count = start\n\n    class Counter:\n        def increment(self):\n            nonlocal count\n            count += 1\n            return count\n\n    def reset():\n        nonlocal count\n        count = start\n\n    return Counter(), reset",
      "hash": "c11cb47de69552c248d6c0c3396edafee3e1684dc76e2e2bc107478f03cd8e17"
