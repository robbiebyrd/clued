        "line": 81,
        "column": 27,
        "offset": 1718
      },
      "text": "class Item:\n    \"\"\"One item of the inventory.\n\n    Items are immutable.\n    \"\"\"\n\n    kind: ClassVar[str] = \"item\"\n    name: str\n    price: float = 0.0\n    tags: list[str] = field(default_factory=list)\n\n    def __post_init__(self) -\u003e None:\n        if self.price \u003c 0:\n            raise ValueError(\"negative price\")\n\n    # total returns the price of n items.\n    def total(self, n: int = 1) -\u003e float:\n        return self.price * n\n\n    @property\n    def label(self) -\u003e str:\n        \"\"\"The item's display label.\"\"\"\n        return f\"{self.name} ({self.price})\"\n\n    @staticmethod\n    def parse(text: str) -\u003e Item:\n        name, _, price = text.partition(\":\")\n        return Item(name=name, price=float(price))\n\n    @classmethod\n    async def fetch(cls, client, key: str) -\u003e \"Item\":\n        data = await client.get(key)\n        return cls(**data)\n\n    def _private(self):\n        pass\n\n    class Meta:\n        \"\"\"Options of the model.\"\"\"\n\n        ordering = [\"name\"]",
      "hash": "571f6bf9458704ac26390c98fc5ce481d411d4b1fde30b0a9af9c5300cc2121c"
    },
