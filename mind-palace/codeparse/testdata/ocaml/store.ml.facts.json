      "text": "(* A key-value store over a functorised map, with a cache. *)\n\nopen Stdlib\nopen! Base\ninclude Store_intf\n\nmodule SMap = Map.Make (String)\nmodule L = List\nmodule Json = Yojson.Safe",
      "hash": "39717ced67b7c1eef42d5ef322116296245aa8e5db7172228cfd9a8b0dd7581b"
    },
    {
      "id": "BACKEND#1",
      "kind": "symbol",
      "symbolId": "BACKEND",
      "start": {
        "line": 11,
        "column": 0,
        "offset": 181
      },
      "end": {
        "line": 15,
        "column": 3,
        "offset": 297
      },
      "text": "module type BACKEND = sig\n  type conn\n  val connect : string -\u003e conn\n  val get : conn -\u003e string -\u003e string option\nend",
      "hash": "bfea6bcd85dfae32a96fc169da5357a64d13825b43e3a60b2ab67a435cc64651"
    },
    {
      "id": "Make#1",
      "kind": "symbol",
      "symbolId": "Make",
      "start": {
        "line": 17,
        "column": 0,
        "offset": 299
      },
      "end": {
        "line": 31,
        "column": 3,
        "offset": 746
      },
      "text": "(** Build a store over any backend. *)\nmodule Make (B : BACKEND) : S with type key = string = struct\n  type key = string\n  type t = { conn : B.conn; mutable cache : string SMap.t }\n\n  let create url = { conn = B.connect url; cache = SMap.empty }\n\n  let find t k =\n    match SMap.find_opt k t.cache with\n    | Some v -\u003e Some v\n    | None -\u003e\n      let v = B.get t.conn k in\n      Option.iter (fun v -\u003e t.cache \u003c- SMap.add k v t.cache) v;\n      v\nend",
      "hash": "bf9186ebfb1e2ba0f1a3afe26a704408ee0aacf948fca50c06749353dddf008e"
    },
    {
      "id": "L33#1",
