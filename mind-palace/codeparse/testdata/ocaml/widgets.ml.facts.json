        "line": 7,
        "column": 3,
        "offset": 201
      },
      "text": "virtual base (name : string) = object\n  val name = name\n  method name = name\n  method virtual render : Buffer.t -\u003e unit\nend",
      "hash": "e79fbe0a0ce1759bdb19586ed1dd5ad682f2f48d3ef60e092dfc27690bd0fef8"
    },
    {
      "id": "button#1",
      "kind": "symbol",
      "symbolId": "button",
      "start": {
        "line": 9,
        "column": 0,
        "offset": 203
      },
      "end": {
        "line": 16,
        "column": 3,
        "offset": 465
      },
      "text": "(** A labelled button. *)\nclass button name ~on_click = object (self)\n  inherit base name as super\n  val mutable clicks = 0\n  method render buf = Buffer.add_string buf self#name\n  method click () = clicks \u003c- clicks + 1; on_click self\n  method clicks = clicks\nend",
      "hash": "843dc6cf2cad64ce5f93e4b17669891e966aabd872d881e5e6f9bd9659813b61"
    },
    {
      "id": "clickable#1",
