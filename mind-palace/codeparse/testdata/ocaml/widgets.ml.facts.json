        "offset": 536
      },
      "end": {
        "line": 22,
        "column": 53,
        "offset": 585
      },
      "text": "make_button () = new button \"ok\" ~on_click:ignore",
      "hash": "dd07e3fc6a83a58865863f23547b39ae5a49cf92cac521b495f1662d607c0ba5"
    },
    {
      "id": "L24#1",
      "kind": "window",
      "start": {
        "line": 24,
        "column": 0,
        "offset": 587
      },
      "end": {
        "line": 27,
        "column": 14,
        "offset": 663
      },
      "text": "let%test \"clicks\" =\n  let b = make_button () in\n  b#click ();\n  b#clicks = 1",
      "hash": "8a17579c6e81c107ca02aacaf86181755b878f023e97a13038f89c5b9f094863"
    },
