        "line": 18,
        "column": 11,
        "offset": 478
      },
      "end": {
        "line": 20,
        "column": 3,
        "offset": 530
      },
      "text": "clickable = object\n  method click : unit -\u003e unit\nend",
      "hash": "730c2d86e3bc617fdd7dc2a49bdd4fd84828a9c3758f53c978a9ac45891d016b"
    },
    {
      "id": "make_button#1",
