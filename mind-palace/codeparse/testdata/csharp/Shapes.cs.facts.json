      },
      "end": {
        "line": 26,
        "column": 5,
        "offset": 546
      },
      "text": "    /// \u003csummary\u003eThe colours a shape can be drawn in.\u003c/summary\u003e\n    public enum Color\n    {\n        Red,\n        Green = 2,\n        Blue,\n    }",
      "hash": "0912ec6ba275bfcae597f0ff85f494dfbd33b52519ea440809cc15125a36fa4e"
