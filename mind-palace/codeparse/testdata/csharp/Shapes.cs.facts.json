      },
      "text": "    /// \u003csummary\u003eA point on the plane.\u003c/summary\u003e\n    public readonly struct Point\n    {\n        public readonly double X;\n        public readonly double Y;\n\n        public Point(double x, double y)\n        {\n            X = x;\n            Y = y;\n        }\n    }",
      "hash": "02e7053f45ef8bc446d126a7d7b76024bfdf00c3e3850f5af6b7a5f0a8ba1bfb"
