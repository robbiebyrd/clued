      "end": {
        "line": 18,
        "column": 5,
        "offset": 401
      },
      "text": "    /// \u003csummary\u003e\n    /// A shape that knows its area.\n    /// \u003c/summary\u003e\n    public interface IShape\n    {\n        /// \u003csummary\u003eThe area in square units.\u003c/summary\u003e\n        double Area();\n\n        string Name { get; }\n\n        event EventHandler Changed;\n    }",
