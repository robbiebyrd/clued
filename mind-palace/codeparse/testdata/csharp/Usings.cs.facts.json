      },
      "text": "// Every form of the using directive, and a file-scoped namespace.\nglobal using System.Linq;\nusing System;\nusing System.IO;\nusing static System.Math;\nusing static System.Console;\nusing Json = System.Text.Json.JsonSerializer;\nusing IntList = System.Collections.Generic.List\u003cint\u003e;\nusing global::System.Threading.Tasks;\n\nnamespace Demo.Tools.Io;",
      "hash": "d573c9d2f25f72185d197511d45e00a3831881ab4a855a10b646472b51bd21cc"
    },
    {
      "id": "Demo.Tools.Io.LineReader#1",
      "kind": "symbol",
      "symbolId": "Demo.Tools.Io.LineReader",
      "start": {
        "line": 13,
        "column": 0,
        "offset": 344
      },
      "end": {
        "line": 27,
        "column": 1,
        "offset": 874
      },
      "text": "/// \u003csummary\u003eReads lines from a file.\u003c/summary\u003e\npublic static class LineReader\n{\n    public static async Task\u003cstring[]\u003e ReadAsync(string path)\n    {\n        using var reader = new StreamReader(path);\n        var text = await reader.ReadToEndAsync();\n        WriteLine(Sqrt(text.Length));\n        return text.Split('\\n').Where(l =\u003e l.Length \u003e 0).ToArray();\n    }\n\n    public static string Dump(object value) =\u003e Json.Serialize(value);\n\n    public static IntList Lengths(string[] lines) =\u003e new IntList(lines.Select(l =\u003e l.Length));\n}",
      "hash": "38d62f8bcadc1cf93116ee1aacf56558798173e06285634cdcc5c169e7005561"
    }
