      },
      "text": "/** An item: id, price and status. */\npublic record Item(String id, long price, Status status) implements Comparable\u003cItem\u003e {\n    public Item {\n        requireNonNull(id);\n    }\n\n    public int compareTo(Item other) {\n        return Long.compare(price, other.price);\n    }\n}",
