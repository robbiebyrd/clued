      },
      "text": "/** Status of an item. */\npublic enum Status implements Labelled {\n    /** On the shelf. */\n    IN_STOCK(\"in stock\"),\n    SOLD_OUT(\"sold out\");\n\n    private final String label;\n\n    Status(String label) {\n        this.label = label;\n    }\n\n    @Override\n    public String label() {\n        return label;\n    }\n}",
      "hash": "6d3d93ed4c1765180ce94715807a4fbf6f4b885c7d5ee5be1bc5dc4a69a5e86f"
