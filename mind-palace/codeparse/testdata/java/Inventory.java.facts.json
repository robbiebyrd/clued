      },
      "text": "/** Store is anything that holds items. */\ninterface Store\u003cT\u003e {\n    int LIMIT = 5;\n\n    boolean add(T item) throws StoreException;\n\n    default int size() {\n        return 0;\n    }\n}",
      "hash": "ecdd0e295c14b2e53824d9863a985c15cf367ca92381fe55220862eec40ec953"
    },
