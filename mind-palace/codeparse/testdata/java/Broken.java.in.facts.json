        "line": 22,
        "column": 1,
        "offset": 416
      },
      "text": "/** Parser reads tokens. */\npublic class Parser {\n    private List\u003cString\u003e tokens;\n\n    /** Reads the next token. */\n    public String next() {\n        return tokens.remove(0)\n    }\n\n    public void skip(int n {\n        for (int i = 0; i \u003c n; i++) next();\n    }\n\n    /** Peeks without consuming. */\n    public String peek() {\n        return tokens.get(0);\n    }\n}",
      "hash": "92523dfdb950ca30629a572ec1cdc454847878896c66a6159724c7d9358eb83c"
    }
