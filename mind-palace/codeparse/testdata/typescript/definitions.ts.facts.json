      "id": "Store#1",
      "kind": "symbol",
      "symbolId": "Store",
      "start": {
        "line": 73,
        "column": 0,
        "offset": 1578
      },
      "end": {
        "line": 111,
        "column": 1,
        "offset": 2392
      },
      "text": "/** A store of entries, kept in memory. */\nexport class Store implements Iterable\u003cEntry\u003e {\n  static instances = 0;\n  readonly name: string;\n  protected entries: Entry[] = [];\n  private dirty = false;\n  #secret = \"s3cr3t\";\n\n  constructor(name: string) {\n    this.name = name;\n    Store.instances++;\n  }\n\n  /** Adds an entry and marks the store dirty. */\n  add(entry: Entry): void {\n    this.entries.push(entry);\n    this.touch();\n  }\n\n  get size(): number {\n    return this.entries.length;\n  }\n\n  private touch(): void {\n    this.dirty = true;\n  }\n\n  #rotate(): void {\n    this.#secret = this.#secret.split(\"\").reverse().join(\"\");\n  }\n\n  async *[Symbol.asyncIterator](): AsyncGenerator\u003cEntry\u003e {\n    yield* this.entries;\n  }\n\n  [Symbol.iterator](): Iterator\u003cEntry\u003e {\n    return this.entries[Symbol.iterator]();\n  }\n}",
      "hash": "4e107a4f09090c75035441066ba6cfe4d423209bf222f3e0923f872692a547e1"
    },
    {
