        "line": 113,
        "column": 7,
        "offset": 2401
      },
      "end": {
        "line": 123,
        "column": 1,
        "offset": 2646
      },
      "text": "abstract class Exporter\u003cT\u003e {\n  abstract write(item: T): Promise\u003cvoid\u003e;\n  protected abstract flush(): void;\n\n  async writeAll(items: T[]): Promise\u003cvoid\u003e {\n    for (const item of items) {\n      await this.write(item);\n    }\n    this.flush();\n  }\n}",
      "hash": "0df06b5efa220edc9cd6a55f9f1b07d94850b9bb347c181d20950ace5477bf17"
