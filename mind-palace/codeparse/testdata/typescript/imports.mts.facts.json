      },
      "text": "async function load(file: string): Promise\u003cEntry[]\u003e {\n  const raw = await readFile(path.join(Default.dir, file), \"utf8\");\n  const plugin = await import(\"./plugins/\" + file);\n  write(file + \".bak\", raw);\n  return plugin.decode(raw, fs.constants.R_OK, lazy);\n}",
      "hash": "8458f682f2a61a4e718c4d1c854df49022f05e23317e5e24355ff417cdb40f2f"
    }
