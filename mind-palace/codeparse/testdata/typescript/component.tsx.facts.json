      },
      "text": "/** A button with an icon and a click counter. */\nexport function Button({ label, onClick, children }: ButtonProps): JSX.Element {\n  const [count, setCount] = useState\u003cnumber\u003e(0);\n  return (\n    \u003cdiv className=\"button\"\u003e\n      \u003cIcon name=\"star\" /\u003e\n      \u003cUI.Label text={label} /\u003e\n      \u003cbutton\n        onClick={() =\u003e {\n          setCount(count + 1);\n          onClick();\n        }}\n      \u003e\n        {children}\n      \u003c/button\u003e\n    \u003c/div\u003e\n  );\n}",
      "hash": "ddf0d2026744f3365315a213ef56dec5c8e637dcc3b3da3c2e24b007ca74f6f9"
    },
