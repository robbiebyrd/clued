      },
      "text": "class UserService extends Base\u003cUser\u003e implements Repository\u003cUser\u003e, events.Listener {\n  @Inject(TOKEN) private readonly db: Database;\n  @Observable\n  users: Map\u003cstring, User\u003e = new Map();\n\n  constructor(private readonly log: Logger) {\n    super();\n  }\n\n  async find(id: string): Promise\u003cUser | undefined\u003e {\n    const row = await this.db.query\u003cUserRow\u003e(sql`select * from users where id = ${id}`);\n    this.log.debug(\"find\", id);\n    return row ? toUser(row) : undefined;\n  }\n\n  save(user: User): void {\n    validate(user);\n    const copy = structuredClone(user);\n    this.users.set(copy.id, copy);\n    this.emitter?.emit(\"saved\", copy);\n  }\n}",
      "hash": "6921fa1d591bacced6130ad4403b5b2f93578998426bec968e6547101c941eb2"
    },
