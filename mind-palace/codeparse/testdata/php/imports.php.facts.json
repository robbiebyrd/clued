      "text": "class UserController\n{\n    public function show(int $id): User\n    {\n        Log::info('showing user', ['id' =\u003e $id]);\n        $user = User::findOrFail($id);\n        Mailer::send($user, money(10));\n        return $user;\n    }\n}",
