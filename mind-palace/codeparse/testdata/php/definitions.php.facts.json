      "text": "\u003c?php\n\ndeclare(strict_types=1);\n\nnamespace App\\Billing;\n\n/**\n * The largest invoice the service accepts, in cents.\n */\nconst MAX_INVOICE = 1_000_000;\n\ndefine('BILLING_VERSION', '2.4');",
