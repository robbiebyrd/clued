        "line": 25,
        "column": 1,
        "offset": 447
      },
      "text": "/**\n * Describes anything that can be charged.\n */\ninterface Chargeable\n{\n    /** The charge's currency, as an ISO 4217 code. */\n    public const CURRENCY = 'EUR';\n\n    public function amount(): int;\n\n    public static function fromArray(array $data): static;\n}",
      "hash": "e4bb0fa7d1512ef97bb2a1f4eda5ed739b85313fbc27b7bcf80b0362dafe6e37"
    },
    {
      "id": "App\\Billing\\Timestamps#1",
      "kind": "symbol",
      "symbolId": "App\\Billing\\Timestamps",
      "start": {
        "line": 27,
