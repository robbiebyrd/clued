      "end": {
        "line": 55,
        "column": 1,
        "offset": 960
      },
      "text": "/**\n * The states an invoice goes through.\n */\nenum Status: string\n{\n    case Draft = 'draft';\n    case Paid = 'paid';\n\n    const DEFAULT = self::Draft;\n\n    public function label(): string\n    {\n        return ucfirst($this-\u003evalue);\n    }\n}",
      "hash": "2ee2b5fb9c556be6c5f1cfe03e4cca6b6789ef38e5b8a40c9d6916a9c54dcd6c"
