        "line": 53,
        "column": 8,
        "offset": 1242
      },
      "text": ";; Registers a shape under a fresh id.\n(defn register!\n  [shape]\n  (let [id (str (UUID/randomUUID))]\n    (swap! registry assoc id shape)\n    id))",
      "hash": "c2a871073e2a40dc731ca4be765250d60e479f437b9f2d548bcfc124dd049e5e"
    },
    {
      "id": "geometry.shapes:total-area#1",
      "kind": "symbol",
      "symbolId": "geometry.shapes:total-area",
      "start": {
        "line": 55,
        "column": 0,
        "offset": 1244
      },
      "end": {
        "line": 62,
        "column": 21,
        "offset": 1440
      },
      "text": "(defn total-area\n  \"Sums the areas of shapes, scaled.\"\n  ([shapes] (total-area shapes *scale*))\n  ([shapes scale]\n   (-\u003e\u003e shapes\n        (map area)\n        (map #(* % scale))\n        (reduce +))))",
      "hash": "7d472ec8b1534bf0e79c94e6d5adda751476089587b748615dacf7192e24327e"
    },
    {
