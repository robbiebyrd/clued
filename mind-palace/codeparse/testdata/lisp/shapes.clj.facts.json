      },
      "end": {
        "line": 72,
        "column": 13,
        "offset": 1637
      },
      "text": "(defmacro with-scale\n  \"Runs body with *scale* bound.\"\n  [s \u0026 body]\n  `(binding [*scale* ~s]\n     (log-scale ~s)\n     ~@body))",
      "hash": "e8fff041c9d78b8fa57f9d8c7a8e1ad6402cda0395b3cb46d05d2ef26d7c6a23"
    },
