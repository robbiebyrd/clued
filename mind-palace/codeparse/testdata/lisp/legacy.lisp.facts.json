      "text": ";;; legacy.lisp --- upper-case code, nested and odd definitions.\n\n(IN-PACKAGE :LEGACY)",
      "hash": "df76f16ce16d7ad02a71ad98447db42a5630f0bd6bbe32cdff53d85462d29a74"
    },
    {
