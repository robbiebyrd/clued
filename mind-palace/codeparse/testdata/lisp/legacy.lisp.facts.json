    {
      "id": "LEGACY:walk-tree#1",
      "kind": "symbol",
      "symbolId": "LEGACY:walk-tree",
      "start": {
        "line": 14,
        "column": 0,
        "offset": 272
      },
      "end": {
        "line": 19,
        "column": 19,
        "offset": 477
      },
      "text": "(defun walk-tree (tree fn)\n  (labels ((walk (node depth)\n             (funcall fn node depth)\n             (dolist (child (node-children node))\n               (walk child (1+ depth)))))\n    (walk tree 0)))",
      "hash": "c6adc5b14aaf6261070a066ad4edb27e726e880998834263a28b5678b5433f9f"
    },
    {
      "id": "LEGACY:parse-config#1",
      "kind": "symbol",
      "symbolId": "LEGACY:parse-config",
      "start": {
        "line": 21,
        "column": 0,
        "offset": 479
      },
      "end": {
        "line": 25,
        "column": 37,
        "offset": 729
      },
      "text": "(defun parse-config (lines)\n  (flet ((trim (s) (string-trim \" \" s)))\n    (multiple-value-bind (key value) (split-line (trim (first lines)))\n      (destructuring-bind (\u0026optional section \u0026rest rest) (parse-key key)\n        (list section rest value)))))",
      "hash": "c8b0ebb22c857e33fdfae7c2f4f9bafe4a837df528e7e5e30a8bb91573a52557"
    },
