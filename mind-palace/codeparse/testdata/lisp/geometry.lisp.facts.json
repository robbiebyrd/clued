        "column": 0,
        "offset": 794
      },
      "end": {
        "line": 30,
        "column": 45,
        "offset": 872
      },
      "text": "(defclass circle (shape a:mixin)\n  ((radius :initarg :radius :reader radius)))",
      "hash": "7f6a0f2adb3f97f087bdfb40171006a8a1b377928a68e94a72f108a2c33d9905"
    },
    {
      "id": "geometry:point#1",
      "kind": "symbol",
      "symbolId": "geometry:point",
      "start": {
        "line": 32,
        "column": 0,
        "offset": 874
      },
      "end": {
        "line": 35,
        "column": 25,
        "offset": 1002
      },
      "text": "(defstruct (point (:include base-point) (:constructor make-point (x y)))\n  \"A point in the plane.\"\n  x\n  (y 0 :type coordinate))",
      "hash": "025f27be7cd3ac8b401a0a1801e67fcb93a54ec4918a118bf0902988a14a7bc9"
    },
    {
      "id": "geometry:invalid-shape#1",
      "kind": "symbol",
      "symbolId": "geometry:invalid-shape",
      "start": {
        "line": 37,
        "column": 0,
        "offset": 1004
      },
      "end": {
        "line": 40,
        "column": 74,
        "offset": 1204
      },
      "text": "(define-condition invalid-shape (error)\n  ((shape :initarg :shape :reader invalid-shape-shape))\n  (:report (lambda (c stream)\n             (format stream \"invalid shape ~a\" (invalid-shape-shape c)))))",
      "hash": "6aaf653f20d52621e9e4c02c38f3e68571d322e7bdec099c3a1a65ac44ca20b7"
    },
    {
      "id": "geometry:area#1",
      "kind": "symbol",
      "symbolId": "geometry:area",
      "start": {
        "line": 42,
        "column": 0,
        "offset": 1206
      },
      "end": {
        "line": 43,
        "column": 40,
        "offset": 1271
      },
      "text": "(defgeneric area (shape)\n  (:documentation \"The area of SHAPE.\"))",
      "hash": "aa41bab6b3b401d2c013e5ef78036c663330f6182b1ba38b6cef1710022c118f"
    },
    {
      "id": "geometry:area~2#1",
      "kind": "symbol",
      "symbolId": "geometry:area~2",
      "start": {
        "line": 45,
        "column": 0,
        "offset": 1273
      },
      "end": {
        "line": 46,
        "column": 29,
        "offset": 1331
      },
      "text": "(defmethod area ((c circle))\n  (* pi (expt (radius c) 2)))",
      "hash": "c1dcfcfa7a4025c4ab0fc4b8ee6d65e687d23a7c1035e05a6bd2a94f6f2f58cd"
    },
    {
      "id": "geometry:area~3#1",
      "kind": "symbol",
      "symbolId": "geometry:area~3",
      "start": {
        "line": 48,
        "column": 0,
        "offset": 1333
      },
      "end": {
        "line": 52,
        "column": 12,
        "offset": 1483
      },
      "text": "(defmethod area :around ((s shape))\n  (let ((result (call-next-method)))\n    (when (minusp result)\n      (error 'invalid-shape :shape s))\n    result))",
      "hash": "01d7744a19b677296a13ca190584037c5dcd933bf0674b495b3424960af1413b"
    },
    {
      "id": "geometry:make-circle#1",
      "kind": "symbol",
      "symbolId": "geometry:make-circle",
      "start": {
        "line": 54,
        "column": 0,
        "offset": 1485
      },
      "end": {
        "line": 59,
        "column": 7,
        "offset": 1719
      },
      "text": "(defun make-circle (radius \u0026key (name \"circle\"))\n  \"Makes a circle of RADIUS, registered under NAME.\"\n  (let ((c (make-instance 'circle :radius radius :name name)))\n    (setf (gethash name *registry*) c)\n    (register-shape c)\n    c))",
      "hash": "4be7ff344bd0040a735a9b26caebb155acc75722a61bd63b0e784b9b8459c277"
    },
    {
      "id": "geometry:scale#1",
      "kind": "symbol",
      "symbolId": "geometry:scale",
      "start": {
        "line": 61,
        "column": 0,
        "offset": 1721
      },
      "end": {
        "line": 65,
        "column": 49,
        "offset": 1920
      },
      "text": ";;; Scales a shape; returns the new one.\n(defun scale (shape factor)\n  (cond ((typep shape 'circle)\n         (make-circle (* (radius shape) factor)))\n        (t (error 'invalid-shape :shape shape))))",
      "hash": "bdbf7beaadca34747e66143a7d54c6d38c9d62e1f1157dd94abb5984f38ec9a7"
    },
    {
      "id": "geometry:total-area#1",
      "kind": "symbol",
      "symbolId": "geometry:total-area",
      "start": {
        "line": 67,
        "column": 0,
        "offset": 1922
      },
      "end": {
        "line": 68,
        "column": 54,
        "offset": 2003
      },
      "text": "(defun total-area (shapes)\n  (reduce #'+ (mapcar #'area (a:ensure-list shapes))))",
      "hash": "17aa9cc3208999e48f7c7d49a7f4ac773f653a9409da88e299fee59aafc33b2b"
    },
    {
      "id": "geometry:safe-area#1",
      "kind": "symbol",
      "symbolId": "geometry:safe-area",
      "start": {
        "line": 70,
        "column": 0,
        "offset": 2005
      },
      "end": {
        "line": 74,
        "column": 10,
        "offset": 2114
      },
      "text": "(defun safe-area (shape)\n  (handler-case (area shape)\n    (invalid-shape (e)\n      (log-problem e)\n      0)))",
      "hash": "42b62af2fbdecc9c6e53cd024221f521b66d5b65fe069f7069245fe83cf4f832"
    },
    {
      "id": "geometry:with-scale#1",
      "kind": "symbol",
      "symbolId": "geometry:with-scale",
      "start": {
        "line": 76,
        "column": 0,
        "offset": 2116
      },
      "end": {
        "line": 80,
        "column": 13,
        "offset": 2288
      },
      "text": "(defmacro with-scale ((factor) \u0026body body)\n  \"Runs BODY with *default-scale* bound to FACTOR.\"\n  `(let ((*default-scale* ,factor))\n     (notify-scale ,factor)\n     ,@body))",
      "hash": "d08e53f0f34c3c9cac009a2c4038430123cd0cb3d5aef2b35d96010c34ce5af7"
    },
    {
      "id": "geometry:draw-all#1",
      "kind": "symbol",
      "symbolId": "geometry:draw-all",
      "start": {
        "line": 82,
        "column": 0,
        "offset": 2290
      },
      "end": {
        "line": 86,
        "column": 31,
        "offset": 2461
      },
      "text": "(defun draw-all (shapes stream)\n  (dolist (s shapes)\n    (when-let (name (shape-name s))\n      (format stream \"~a: ~,2f~%\" name (area s))))\n  (uiop:println \"done\" stream))",
      "hash": "b344c0239f3606271e937d22ff8f120cf2684ab2446d9113bf5172781254d45b"
    }
  ]
}
