    {
      "id": "main#1",
      "kind": "symbol",
      "symbolId": "main",
      "start": {
        "line": 18,
        "column": 0,
        "offset": 391
      },
      "end": {
        "line": 23,
        "column": 57,
        "offset": 592
      },
      "text": "(define (main args)\n  (match args\n    ((_ name) (greet name))\n    (_ (usage)))\n  (for-each (lambda (a) (display (string-pad a 10))) (cdr args))\n  (format #t \"~a~%\" (fold + 0 (map string-length args))))",
      "hash": "a6bd80636030d027e0f2c976184f6bf7c19fd17aa23dfa7197951bae209f6aa6"
