      "end": {
        "line": 13,
        "column": 55,
        "offset": 355
      },
      "text": "(define-syntax unless*\n  (syntax-rules ()\n    ((_ test body ...) (if test #f (begin body ...)))))",
      "hash": "e5112a94f63dda4dd0a4ccafccd460980156547b3c1f940f87cd7ddf1150d964"
