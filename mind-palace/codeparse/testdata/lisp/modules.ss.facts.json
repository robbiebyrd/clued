      },
      "text": ";; Guile and Chicken style modules, in a .ss file.\n(define-module (app main)\n  #:use-module (ice-9 match)\n  #:use-module (srfi srfi-1)\n  #:export (main))\n\n(use-modules (ice-9 format))\n(import chicken.string (only srfi-13 string-pad))\n(include \"config.scm\")",
      "hash": "5fb49f81994ce36e30834f574d5d8383f73518f4e2e8cbfb253341a4a7a07be2"
    },
    {
