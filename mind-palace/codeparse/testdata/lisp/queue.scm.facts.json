      },
      "text": ";;; queue.scm -- a functional queue as an R7RS library.\n\n(define-library (data queue)\n  (export make-queue queue-empty? enqueue dequeue queue-\u003elist)\n  (import (scheme base)\n          (scheme write)\n          (only (srfi 1) fold append-reverse)\n          (prefix (data util) util:))\n  (begin",
      "hash": "ae8a492a74cec8b38b6e1dd1ff066a818a2a15f3e041a57207748e5a1a24a35f"
    },
    {
      "id": "(data queue):queue#1",
      "kind": "symbol",
      "symbolId": "(data queue):queue",
      "start": {
        "line": 10,
        "column": 0,
        "offset": 291
      },
      "end": {
        "line": 15,
        "column": 40,
        "offset": 488
      },
      "text": "    ;; A queue is a front list and a reversed back list.\n    (define-record-type queue\n      (%make-queue front back)\n      queue?\n      (front queue-front)\n      (back queue-back set-queue-back!))",
      "hash": "fdb40302a50f57721ccb71928405232f65c9891b6177c56d97cac47d37fa8f3f"
    },
    {
      "id": "L17#1",
      "kind": "window",
      "start": {
        "line": 17,
        "column": 0,
        "offset": 490
      },
      "end": {
        "line": 17,
        "column": 28,
        "offset": 518
      },
      "text": "    (define empty-front '())",
      "hash": "ea6967c91b1e0a4e907cae901b52e273002163e029ebc31a90b52426d1406b7b"
    },
    {
      "id": "(data queue):make-queue#1",
      "kind": "symbol",
      "symbolId": "(data queue):make-queue",
      "start": {
        "line": 19,
        "column": 0,
        "offset": 520
      },
      "end": {
        "line": 19,
        "column": 55,
        "offset": 575
      },
      "text": "    (define (make-queue) (%make-queue empty-front '()))",
      "hash": "2ebeeadfb145fa3766f0b7b06847c328cc0e4549af1ce5563912b3fe014c2f41"
    },
    {
      "id": "(data queue):queue-empty?#1",
      "kind": "symbol",
      "symbolId": "(data queue):queue-empty?",
      "start": {
        "line": 21,
        "column": 0,
        "offset": 577
      },
      "end": {
        "line": 22,
        "column": 59,
        "offset": 665
      },
      "text": "    (define (queue-empty? q)\n      (and (null? (queue-front q)) (null? (queue-back q))))",
      "hash": "1c9219e0bd671da4ab437c1a99e51091e04a174635cb185695f5957a353539fd"
    },
    {
      "id": "(data queue):enqueue#1",
      "kind": "symbol",
      "symbolId": "(data queue):enqueue",
      "start": {
        "line": 24,
        "column": 0,
        "offset": 667
      },
      "end": {
        "line": 26,
        "column": 60,
        "offset": 780
      },
      "text": "    ;; Adds x at the back.\n    (define (enqueue q x)\n      (%make-queue (queue-front q) (cons x (queue-back q))))",
      "hash": "6ee4f33747d26f231f80358803c3dc5e263aa519637dc01bd40726d6fe9c0ba0"
    },
    {
      "id": "(data queue):dequeue#1",
      "kind": "symbol",
      "symbolId": "(data queue):dequeue",
      "start": {
        "line": 28,
        "column": 0,
        "offset": 782
      },
      "end": {
        "line": 34,
        "column": 75,
        "offset": 1110
      },
      "text": "    (define (dequeue q)\n      (cond ((queue-empty? q) (error \"dequeue: empty queue\" q))\n            ((null? (queue-front q))\n             (dequeue (%make-queue (reverse (queue-back q)) '())))\n            (else\n             (values (car (queue-front q))\n                     (%make-queue (cdr (queue-front q)) (queue-back q))))))",
      "hash": "02dde4199d81aeef1304c47bae3d833d9cf99e72f4e1e3097ea0ac42da8344c9"
    },
    {
      "id": "(data queue):queue-\u003elist#1",
      "kind": "symbol",
      "symbolId": "(data queue):queue-\u003elist",
      "start": {
        "line": 36,
        "column": 0,
        "offset": 1112
      },
      "end": {
        "line": 41,
        "column": 42,
        "offset": 1320
      },
      "text": "    (define (queue-\u003elist q)\n      (let loop ((q q) (acc '()))\n        (if (queue-empty? q)\n            (reverse acc)\n            (let-values (((x rest) (dequeue q)))\n              (loop rest (cons x acc))))))",
      "hash": "52283ac9228edea2e85c85632f6054b36f649963955c4f878dfc0b69506d6cde"
    },
    {
      "id": "(data queue):with-queue#1",
      "kind": "symbol",
      "symbolId": "(data queue):with-queue",
      "start": {
        "line": 43,
        "column": 0,
        "offset": 1322
      },
      "end": {
        "line": 47,
        "column": 23,
        "offset": 1480
      },
      "text": "    (define-syntax with-queue\n      (syntax-rules ()\n        ((_ (name init) body ...)\n         (let ((name (util:ensure-queue init)))\n           body ...))))",
      "hash": "feebaeb8a3d3dfb320ef0c8ad2b7824f0a279e1d73b1a4746c4e2fb4e75434fb"
    },
    {
      "id": "(data queue):sum#1",
      "kind": "symbol",
      "symbolId": "(data queue):sum",
      "start": {
        "line": 49,
        "column": 0,
        "offset": 1482
      },
      "end": {
        "line": 50,
        "column": 33,
        "offset": 1535
      },
      "text": "    (define (sum q)\n      (fold + 0 (queue-\u003elist q)))",
      "hash": "7f2e569e4fa0fa8e8a8cde041eb0d968a9787f43844cafce1fdc5f1b4903c36e"
    }
