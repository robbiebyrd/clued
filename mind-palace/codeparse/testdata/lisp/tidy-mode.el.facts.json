      "text": "(cl-defmethod tidy-apply ((rule tidy-rule))\n  (save-excursion\n    (goto-char (point-min))\n    (while (re-search-forward (oref rule pattern) nil t)\n      (replace-match \"\"))))",
      "hash": "3acb007ed4ec11699b1ca067c3181a2b1e069508c22dba632b772359cf6ec569"
    },
    {
      "id": "tidy-trim-buffer#1",
      "kind": "symbol",
      "symbolId": "tidy-trim-buffer",
      "start": {
        "line": 52,
        "column": 0,
        "offset": 1255
      },
      "end": {
        "line": 63,
        "column": 32,
        "offset": 1616
      },
      "text": ";; Trims trailing white space; returns the number of lines changed.\n(defun tidy-trim-buffer ()\n  (interactive)\n  (let ((count 0))\n    (save-excursion\n      (goto-char (point-min))\n      (while (not (eobp))\n        (when (looking-at-p \".*[ \\t]+$\")\n          (cl-incf count)\n          (tidy--trim-line))\n        (forward-line 1)))\n    (setq tidy--changes count)))",
      "hash": "99a62d8a65e6d35e9eb830940ac84eca8c47d42f5824e70679ea06aacc50f60c"
    },
    {
      "id": "tidy--trim-line#1",
      "kind": "symbol",
      "symbolId": "tidy--trim-line",
      "start": {
        "line": 65,
        "column": 0,
        "offset": 1618
      },
      "end": {
        "line": 67,
        "column": 77,
        "offset": 1775
      },
      "text": "(defsubst tidy--trim-line ()\n  \"Delete the white space at the end of the line.\"\n  (delete-trailing-whitespace (line-beginning-position) (line-end-position)))",
      "hash": "16da3a320e96779635c96c1414df5c0c9459171ae67a2b2dc32ae5492400cf6f"
    },
    {
      "id": "tidy-with-report#1",
      "kind": "symbol",
      "symbolId": "tidy-with-report",
      "start": {
        "line": 69,
        "column": 0,
        "offset": 1777
      },
      "end": {
        "line": 73,
        "column": 44,
        "offset": 1943
      },
      "text": "(defmacro tidy-with-report (\u0026rest body)\n  \"Run BODY and message what changed.\"\n  `(let ((start (float-time)))\n     ,@body\n     (tidy--report (- (float-time) start))))",
      "hash": "5cd4f7b1f46e9fa9344d80da4ce9e2b8dfd42953362b3f85aa2d6f3d5b2d22ad"
    },
    {
      "id": "tidy--report#1",
      "kind": "symbol",
      "symbolId": "tidy--report",
      "start": {
        "line": 75,
        "column": 0,
        "offset": 1945
      },
      "end": {
        "line": 78,
        "column": 63,
        "offset": 2100
      },
      "text": "(cl-defun tidy--report (seconds \u0026key (verbose t))\n  \"Report SECONDS spent.\"\n  (when verbose\n    (message \"tidy: %d lines in %.2fs\" tidy--changes seconds)))",
      "hash": "2509542e5f8eab80dd2bc71e616eb5cb5cca43a05aa315263862b26658dce2e1"
    },
    {
      "id": "tidy--maybe-run#1",
      "kind": "symbol",
      "symbolId": "tidy--maybe-run",
      "start": {
        "line": 80,
        "column": 0,
        "offset": 2102
      },
      "end": {
        "line": 83,
        "column": 37,
        "offset": 2284
      },
      "text": "(defun tidy--maybe-run ()\n  (cond ((memq major-mode tidy-ignored-modes) nil)\n        ((buffer-modified-p) (tidy-with-report (tidy-trim-buffer)))\n        (t (tidy--log \"unchanged\"))))",
      "hash": "f03f96175ddeb591fc5d6fb963b497721c2dee285be0603a3381924e94b9e837"
    },
    {
      "id": "tidy-mode#1",
      "kind": "symbol",
      "symbolId": "tidy-mode",
      "start": {
        "line": 85,
        "column": 0,
        "offset": 2286
      },
      "end": {
        "line": 90,
        "column": 57,
        "offset": 2501
      },
      "text": "(define-minor-mode tidy-mode\n  \"Tidy the buffer before saving.\"\n  :lighter \" Tidy\"\n  (if tidy-mode\n      (add-hook 'before-save-hook #'tidy--maybe-run nil t)\n    (remove-hook 'before-save-hook #'tidy--maybe-run t)))",
      "hash": "6e1fd35e85ec615f669335007284b1465f92bc2c4e26d0e82f52b3807d186ce9"
