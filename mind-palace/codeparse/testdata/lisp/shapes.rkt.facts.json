        "column": 0,
        "offset": 396
      },
      "end": {
        "line": 17,
        "column": 34,
        "offset": 455
      },
      "text": ";; A point in the plane.\n(struct point (x y) #:transparent)",
      "hash": "3535d1d6635faa74da4897decc0ba61ea60f31d3dbe6b4a57e87a97671482150"
    },
    {
      "id": "point3#1",
