      },
      "text": "(struct point3 point (z [label #:mutable]))",
      "hash": "726e450c07b96b268a487f7198ab7e07694f85827db3d7cc6b1b05ded7b9111e"
    },
    {
      "id": "L21#1",
      "kind": "window",
      "start": {
        "line": 21,
        "column": 0,
        "offset": 502
      },
      "end": {
        "line": 39,
        "column": 28,
        "offset": 952
      },
      "text": "(define origin (point 0 0))\n\n(define shape\u003c%\u003e (interface () area perimeter))\n\n(define shape%\n  (class* object% (shape\u003c%\u003e)\n    (init-field [name \"shape\"])\n    (super-new)\n    (define/public (area) 0)\n    (define/public (perimeter) 0)\n    (define/private (log-area)\n      (printf \"~a: ~a\\n\" name (area)))))\n\n(define circle%\n  (class shape%\n    (init-field radius)\n    (super-new [name \"circle\"])\n    (define/override (area)\n      (* pi (sqr radius)))))",
      "hash": "d71c64c467e2d65949144d50f1ca474d0623e54d4cc6f141ba66148169d7e0b5"
    },
    {
      "id": "area#1",
      "kind": "symbol",
      "symbolId": "area",
      "start": {
        "line": 41,
        "column": 0,
        "offset": 954
      },
      "end": {
        "line": 45,
        "column": 49,
        "offset": 1129
      },
      "text": "(define (area s)\n  (match s\n    [(point x y) (distance origin (point x y))]\n    [(? (λ (v) (is-a? v shape%))) (send s area)]\n    [_ (raise-argument-error 'area \"shape?\" s)]))",
      "hash": "823b064812d959fc667c5696cbb93de2bf00b0180f440acacf21f43dcefd509b"
    },
    {
      "id": "distance#1",
      "kind": "symbol",
      "symbolId": "distance",
      "start": {
        "line": 47,
        "column": 0,
        "offset": 1131
      },
      "end": {
        "line": 50,
        "column": 47,
        "offset": 1282
      },
      "text": "(define/contract (distance a b)\n  (-\u003e point? point? real?)\n  (sqrt (+ (sqr (- (point-x a) (point-x b)))\n           (sqr (- (point-y a) (point-y b))))))",
      "hash": "b02cc94b85091ab1a429a2c4a301dacc911ecbc543f686d55bda3cfc37f3844f"
    },
