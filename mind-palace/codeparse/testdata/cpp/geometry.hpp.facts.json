        "line": 80,
        "column": 0,
        "offset": 1542
      },
      "end": {
        "line": 84,
        "column": 1,
        "offset": 1631
      },
      "text": "/// Value holds one of two representations.\nunion Value {\n  int asInt;\n  float asFloat;\n}",
      "hash": "bdbade4c774f907017e0a0002a03d86914dc5f7feeae686f53a30387b75d7877"
    },
    {
      "id": "geometry::Registry#1",
      "kind": "symbol",
