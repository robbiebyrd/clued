      "end": {
        "line": 11,
        "column": 0,
        "offset": 222
      },
      "text": "#define GEOMETRY_SQUARE(x) ((x) * (x))\n",
      "hash": "35c149763654ad00a2e31bb4e03c67ea183430bfffc44ef93985b572b76f9163"
    },
    {
      "id": "L12#1",
      "kind": "window",
      "start": {
        "line": 12,
        "column": 0,
        "offset": 223
      },
      "end": {
        "line": 18,
        "column": 22,
        "offset": 392
      },
      "text": "namespace geometry {\n\n/// Pi, to the precision the shapes need.\nconstexpr double kPi = 3.14159265358979;\n\n/// The number of shapes created so far.\nextern int shapeCount;",
      "hash": "c9db938530653bde655432de98fd5c8345fc215ef42d25c3f84901167d0afff3"
    },
    {
      "id": "geometry::Unit#1",
      "kind": "symbol",
      "symbolId": "geometry::Unit",
      "start": {
        "line": 20,
        "column": 0,
        "offset": 394
      },
      "end": {
        "line": 21,
        "column": 37,
        "offset": 477
      },
      "text": "/// Unit is the unit a length is measured in.\nenum class Unit { Millimetre, Metre }",
      "hash": "1c94d2db9896cd652d3f671ccbe35f8d3137b7af3086a459be0245c3556675d8"
    },
    {
      "id": "geometry::Colour#1",
      "kind": "symbol",
      "symbolId": "geometry::Colour",
      "start": {
        "line": 23,
        "column": 0,
        "offset": 480
      },
      "end": {
        "line": 28,
        "column": 1,
        "offset": 553
      },
      "text": "/// Colour is a shape's fill.\nenum Colour {\n  Red,\n  Green = 2,\n  Blue,\n}",
      "hash": "e17b16bdd0dba30384396233993f869765be2a1b8f16fb370b709b2e7e533be8"
    },
    {
      "id": "geometry::Length#1",
      "kind": "symbol",
      "symbolId": "geometry::Length",
      "start": {
        "line": 30,
        "column": 0,
        "offset": 556
      },
      "end": {
        "line": 31,
        "column": 22,
        "offset": 614
      },
      "text": "/// Length is a distance in metres.\nusing Length = double;",
      "hash": "454b0d79520ddf23622e4c1d88e07080451ebb94aa382e232eb93b3aaf26c627"
    },
    {
      "id": "geometry::Callback#1",
      "kind": "symbol",
      "symbolId": "geometry::Callback",
      "start": {
        "line": 33,
        "column": 0,
        "offset": 616
      },
      "end": {
        "line": 34,
        "column": 33,
        "offset": 694
      },
      "text": "/// Callback is called when a shape changes.\ntypedef void (*Callback)(int id);",
      "hash": "5d7bd542adbce2adb8380b6f1bac543a86a3e076af467accd64bea1afb1baf10"
    },
    {
      "id": "geometry::Shape#1",
      "kind": "symbol",
      "symbolId": "geometry::Shape",
      "start": {
        "line": 36,
        "column": 0,
        "offset": 696
      },
      "end": {
        "line": 58,
        "column": 1,
        "offset": 1177
      },
      "text": "/**\n * Shape is the base of every shape.\n */\nclass Shape {\n public:\n  /// Shape creates a shape with a name.\n  explicit Shape(std::string name);\n  virtual ~Shape() = default;\n\n  /// Area is the shape's area in square units.\n  virtual double area() const = 0;\n\n  /// Name returns the shape's name.\n  const std::string\u0026 name() const { return name_; }\n\n  bool operator==(const Shape\u0026 other) const;\n\n  static int count();\n\n protected:\n  std::string name_;\n  Unit unit_ = Unit::Metre;\n}",
      "hash": "ab164299b7b438362fe3357165e2e98c542852ad154615f099bb83bf631aeeda"
    },
    {
      "id": "geometry::Circle#1",
      "kind": "symbol",
      "symbolId": "geometry::Circle",
      "start": {
        "line": 60,
        "column": 0,
        "offset": 1180
      },
      "end": {
        "line": 69,
        "column": 1,
        "offset": 1372
      },
      "text": "/// Circle is a round shape.\nclass Circle final : public Shape {\n public:\n  Circle(Point centre, Length radius);\n  double area() const override;\n\n private:\n  Point centre_;\n  Length radius_;\n}",
      "hash": "f629ef698d28190646737626194bdf4e835df9e38af420fb1e669c8bb27ebfdc"
    },
    {
      "id": "geometry::Bounds#1",
      "kind": "symbol",
      "symbolId": "geometry::Bounds",
      "start": {
        "line": 71,
        "column": 0,
        "offset": 1375
      },
      "end": {
        "line": 78,
        "column": 1,
        "offset": 1539
      },
      "text": "/// Bounds is an axis-aligned box.\nstruct Bounds {\n  Point min;\n  Point max;\n\n  /// Contains reports whether p lies inside.\n  bool contains(const Point\u0026 p) const;\n}",
      "hash": "0508c03c777007a20778690a462efb3c4ffddc719d3733eba46accccb7919e6e"
    },
    {
      "id": "geometry::Value#1",
