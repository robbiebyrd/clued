        "column": 0,
        "offset": 183
      },
      "text": "#define GEOMETRY_VERSION 3\n",
      "hash": "fabe1b85593cc46e32afc98c1a8dc632f1bbd8958f47095c702a87f13cb37380"
    },
    {
      "id": "GEOMETRY_SQUARE#1",
