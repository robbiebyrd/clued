        "line": 7,
        "column": 29,
        "offset": 154
      },
      "text": "// geometry.hpp: shapes and the registry that owns them.\n#pragma once\n\n#include \u003cmemory\u003e\n#include \u003cstring\u003e\n#include \u003cvector\u003e\n#include \"geometry/point.hpp\"",
      "hash": "8b65f856b3931f989759cf78c1df15062456b8c614409863169ac15b423cdafa"
